          'label': 'Table HLP'},
}


def load_data(path=_DATA) -> dict:
    with open(path, encoding='utf-8') as fh:
        return json.load(fh)


def get_key(data: dict, dotted: str):
    """Resolve 'p5.search' style paths."""
    cur = data
    for part in dotted.split('.'):
        cur = cur[part]
    return cur


def _check_stamp(data: dict, p: dict) -> None:
    """The JSON must come from the same parameters as the TOML in use."""
    m, vg = data['meta'], p['val_gen']
    got = (m['N_val'], m['params']['T'], m['params']['G'])
    want = (p['N_val'], vg['T'], vg['G'])
    if got != want:
        raise ValueError(f'valgen_data.json stamp (N_val, T, G) = {got} != TOML {want}; re-run valgen_core.py')


def _stub(pid):
    def build(data, p):
        raise NotImplementedError(f'Table {pid} not built')
    build.__name__ = f'build_{pid}'
    return build


BUILDERS = {pid: _stub(pid) for pid in PAIRS}


# ── HLC headline contrast ────────────────────────────────────────────────────

def _g12_cols(data: dict, p: dict):
    """Rule/lambda columns for HLC: base then candidate rule, worst case then lambda_base."""
    hl = get_key(data, 'p5.headline')
    lam_base = p['val_gen']['lambda_base']
    rules = hl['rules']                       # ordered base -> candidate
    lams = [0.0, lam_base]
    return hl, rules, lams


def build_HLC(data: dict, p: dict) -> dict:
    hl, rules, lams = _g12_cols(data, p)
    conv = get_key(data, 'p5.conventional_baseline')
    ceil_all = get_key(data, 'p5.no_tax_ceiling')['gain_ceiling_by_rule_lambda']
    cand = rules[-1]
    ceiling = ceil_all[f'{cand}|{lams[-1]}']
    alphas = [a for a in sorted(hl['alphas'], reverse=True) if a <= 1.0]    # axis runs 1 -> 0
    heads = ['Declaration ratio α', 'Conventional tax']
    for r in rules:
        for lam in lams:
            heads.append(f'WDT {r}, λ = {lam:.0%}')
    heads.append(f'Best strategy ({cand}, λ = {lams[-1]:.0%})')
    rows, values = [], []
    for a in alphas:
        cv = conv['diag_alpha'][str(a)]
        row = [f'**{a:g}**', fmt_pct(cv, 1)]
        values += [a, cv]
        for r in rules:
            for lam in lams:
                c = hl['by_rule'][r][str(lam)][str(a)]
                row.append(fmt_pct(c['gain'], 1) if c['gain'] is not None else 'n/a')
                if c['gain'] is not None:
                    values.append(c['gain'])
        row.append(hl['by_rule'][cand][str(lams[-1])][str(a)]['label'])
        rows.append(row)
    m = data['meta']
    cap = (f"Table HLC: Gain over the honest family, as a share of its terminal wealth, by declaration ratio α. "
           f"Conventional: self-declared flat tax of {fmt_pct(conv['rate'], 3)} a year, calibrated to the WDT honest "
           f"burden, no audits modelled, α_C = α_D. WDT: best response over every strategy that deviates at exactly "
           f"that α (lower bound, {data['p5']['n_strategies']}-strategy library plus single-level slices), at λ = "
           f"{lams[0]:.0%} (worst case) and λ = {lams[-1]:.0%}. α = 0 is undefined for the WDT (zero declared price). "
           f"No-tax ceiling {fmt_pct(ceiling, 1)}: a leak check, not a result. "
           f"T = {m['params']['T']}, G = {m['params']['G']}, N_val = {m['N_val']}.")
    values.append(ceiling)
    return {'md': md_table(heads, rows, col_fmt=['center'] * (len(heads) - 1) + ['left']) + '\n\n' + cap,
            'values': values}


BUILDERS['HLC'] = build_HLC


def _chain(p: dict, data: dict) -> list:
    """Ablation chain: start from the first value of each rule list, then adopt each component's
    last value in turn (cap, verify-down, auction). Rule keys are checked against p5.rules."""
    vg = p['val_gen']
    c, v, d = vg['c_cap_rules'], vg['verify_down_rules'], vg['d_auction_rules']
    steps = [(c[0], v[0], d[0]), (c[-1], v[0], d[0]), (c[-1], v[-1], d[0]), (c[-1], v[-1], d[-1])]
    keys = []
    for s in steps:
        k = '/'.join(s)
        if k not in keys:
            keys.append(k)
    missing = [k for k in keys if k not in get_key(data, 'p5.rules')]
    if missing:
        raise KeyError(f'rule sets {missing} not in p5.rules')
    return keys


# ── ABL ablation by lambda ────────────────────────────────────────────────────

def build_ABL(data: dict, p: dict) -> dict:
    srch = get_key(data, 'p5.search')
    lams = get_key(data, 'p5.lambda_vals')
    chain = _chain(p, data)
    heads = ['Rule set (cap / verify-down / auction)'] + [f'λ = {l:.0%}' for l in lams]
    rows, values = [], list(lams)
    for r in chain:
        row = [f'**{r}**']
        for l in lams:
            b = srch[f'{r}|{l}']['best']
            row.append(f"{fmt_pct(b['gain'], 1)} ({b['label']})")
            values.append(b['gain'])
        rows.append(row)
    th = get_key(data, 'p5.thresholds')
    m = data['meta']
    cap = (f"Table ABL: Best-response gain over the honest family (share of its terminal wealth) by rule set and "
           f"verification hazard λ, with the strategy that achieves it. Rule sets are added in the order adopted; "
           f"the BRG threshold is {fmt_pct(th['brg_tol'], 1)}. Best of {data['p5']['n_strategies']} strategies, a lower "
           f"bound on the true best response. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * len(lams)) + '\n\n' + cap, 'values': values}


# ── FBR best response by strategy family ──────────────────────────────────────

def build_FBR(data: dict, p: dict) -> dict:
    srch = get_key(data, 'p5.search')
    lams = get_key(data, 'p5.lambda_vals')
    rule = _chain(p, data)[-1]
    lam_b = p['val_gen']['lambda_base']
    show = [lams[0], lam_b, lams[-1]]
    fams = list(srch[f'{rule}|{lam_b}']['best_by_family'])
    heads = ['Strategy family'] + [f'λ = {l:.0%}' for l in show] + [f'Strategy at λ = {lam_b:.0%}']
    rows, values = [], []
    for f in fams:
        row = [f'**{f}**']
        for l in show:
            g = srch[f'{rule}|{l}']['best_by_family'][f]['gain']
            row.append(fmt_pct(g, 1))
            values.append(g)
        row.append(srch[f'{rule}|{lam_b}']['best_by_family'][f]['label'])
        rows.append(row)
    m = data['meta']
    cap = (f"Table FBR: Best-response gain by strategy family under {rule}, at λ = {show[0]:.0%}, {show[1]:.0%} and "
           f"{show[2]:.0%}. Gain is a share of the honest family's terminal wealth; each cell is the best strategy "
           f"in that family. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * len(show) + ['left']) + '\n\n' + cap,
            'values': values}


# ── GLM growth x lambda surface ──────────────────────────────────────────────

def build_GLM(data: dict, p: dict) -> dict:
    gs = get_key(data, 'p5.growth_surface')
    rule = list(gs['by_rule'])[0]
    lams = get_key(data, 'p5.lambda_vals')
    th = get_key(data, 'p5.thresholds')
    heads = ['Growth g'] + [f'λ = {l:.0%}' for l in lams] + ['Honest terminal wealth (£m)']
    rows, values = [], []
    for g in gs['growth_vals']:
        cell = gs['by_rule'][rule][str(g)]
        row = [f'**{g:.2%}**']
        for l in lams:
            c = cell['by_lambda'][str(l)]
            row.append(f"{fmt_pct(c['gain'], 1)} BRG {'pass' if c['BRG'] else 'FAIL'} SPT {'pass' if c['SPT'] else 'FAIL'} SST {'pass' if c['SST'] else 'FAIL'}")
            values.append(c['gain'])
        row.append(f"{cell['honest_TW_m']:,.1f}")
        rows.append(row)
    m = data['meta']
    cap = (f"Table GLM: Best-response gain by asset growth g and verification hazard λ under {rule}, with the BRG "
           f"(gain at most {fmt_pct(th['brg_tol'], 1)}) and SPT and SST (PV and stake within ±{fmt_pct(th['state_tol'], 1)}) "
           f"verdicts. Growth and λ are independent inputs. Gain is a share of honest terminal wealth; the last "
           f"column gives its scale. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * (len(lams) + 1)) + '\n\n' + cap,
            'values': values}


# ── HCS shock cost ───────────────────────────────────────────────────────────

def build_HCS(data: dict, p: dict) -> dict:
    cost = get_key(data, 'p5.g2_honest_shock_cost')
    th = get_key(data, 'p5.thresholds')
    rules = list(cost)
    shocks = list(cost[rules[0]])
    heads = ['Rule set (cap / verify-down / auction)'] + [f'Fall of {abs(float(s)):.0%} in year {data["p5"]["shock_year"]}' for s in shocks]
    rows, values = [], []
    for r in rules:
        row = [f'**{r}**']
        for s in shocks:
            row.append(fmt_pct(cost[r][s], 3))
            values.append(cost[r][s])
        rows.append(row)
    m = data['meta']
    cap = (f"Table HCS: Cost to an honest family of each rule set after a genuine one-year market fall, as the "
           f"change in terminal net worth against the base rule set (negative = the rule costs honest families). "
           f"Honest declaration means verification plays no part. The HSC tolerance is {fmt_pct(th['hsc_tol'], 1)}. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * len(shocks)) + '\n\n' + cap, 'values': values}


# ── VMP verdict map ───────────────────────────────────────────────────────────

def build_VMP(data: dict, p: dict) -> dict:
    srch = get_key(data, 'p5.search')
    lams = get_key(data, 'p5.lambda_vals')
    th = get_key(data, 'p5.thresholds')
    vb = get_key(data, 'p5.verdict_by_rule')
    rules = get_key(data, 'p5.rules')
    heads = ['Rule set'] + [f'λ = {l:.0%}: BRG best gain' for l in lams] + ['HSC worst cost'] \
        + [f'λ = {l:.0%}: SST worst stake' for l in lams]
    rows, values = [], []
    for r in rules:
        row = [f'**{r}**']
        for l in lams:
            s = srch[f'{r}|{l}']
            row.append(f"{fmt_pct(s['best']['gain'], 1)} {'pass' if s['BRG_pass'] else 'FAIL'}")
            values.append(s['best']['gain'])
        c2 = max(vb[r]['HSC_cost'].values(), key=abs)
        row.append(f"{fmt_pct(c2, 3)} {'pass' if vb[r]['HSC'] else 'FAIL'}")
        values.append(c2)
        for l in lams:
            s = srch[f'{r}|{l}']
            w = s['worst_state']
            if w is None:
                row.append('no gaining strategy')
            else:
                row.append(f"{fmt_pct(w['value'], 1)} {'pass' if abs(w['value']) <= th['state_tol'] else 'FAIL'}")
                values.append(w['value'])
        rows.append(row)
    m = data['meta']
    cap = (f"Table VMP: Verdicts by rule set and verification hazard λ. BRG: best-response gain at most "
           f"{fmt_pct(th['brg_tol'], 1)}. HSC: honest-family cost in a market fall at most {fmt_pct(th['hsc_tol'], 1)} "
           f"(independent of λ). SST: among strategies that gain, the largest change in the state's terminal stake "
           f"stays within ±{fmt_pct(th['state_tol'], 1)}; the PV test (SPT) is in the PSS table. Thresholds are placeholders. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * (len(heads) - 1)) + '\n\n' + cap,
            'values': values}


# ── PSS SPT/SST scatter ───────────────────────────────────────────────────────────

_G10_TOP = 10


def build_PSS(data: dict, p: dict) -> dict:
    th = get_key(data, 'p5.thresholds')
    rule = _chain(p, data)[-1]
    lam_b = p['val_gen']['lambda_base']
    allr = get_key(data, 'p5.search')[f'{rule}|{lam_b}']['all']
    gaining = [r for r in allr if r['gain'] > 0.0 and r['state_rel'] is not None and r['pv_rel'] is not None]
    gaining.sort(key=lambda r: -max(abs(r['state_rel']), abs(r['pv_rel'])))
    top = gaining[:_G10_TOP]
    heads = ['Strategy', 'Gain', 'PV revenue change', 'State stake change']
    rows, values = [], []
    for r in top:
        rows.append([r['label'], fmt_pct(r['gain'], 2), fmt_pct(r['pv_rel'], 2), fmt_pct(r['state_rel'], 2)])
        values += [r['gain'], r['pv_rel'], r['state_rel']]
    m = data['meta']
    cap = (f"Table PSS: The {len(top)} gaining strategies with the largest change in the state's PV revenue or terminal "
           f"stake, under {rule} at λ = {lam_b:.0%}, out of {len(allr)} strategies. SPT and SST hold when both changes are "
           f"within ±{fmt_pct(th['state_tol'], 1)}. Changes are against the honest family. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'center', 'center', 'center']) + '\n\n' + cap, 'values': values}


BUILDERS.update({'ABL': build_ABL, 'VMP': build_VMP, 'FBR': build_FBR, 'PSS': build_PSS,
                 'GLM': build_GLM, 'HCS': build_HCS})



# ── mechanism set: UCC to VSY ──────────────────────────────────────────────────

def _lab_reset(n) -> str:
    return 'never' if int(n) == 0 else f'every {int(n)}y'


def build_UCC(data: dict, p: dict) -> dict:
    rt = get_key(data, 'p2b_round_trip_units')
    osc = get_key(data, 'p2b_oscillation')
    bm = get_key(data, 'p2_benchmark_plan_s1')
    rows, values = [], []
    for k, v in rt.items():
        rows.append(['Round trip: price up then back', f'{k} rule', f'{v:.5f}', 'cap: 1 unit'])
        values.append(v)
    for i, f in enumerate(osc['first_flows']):
        rows.append(['Oscillation of a one-off delta', f'flow {i}', f'{f:.4f}', ''])
        values.append(f)
    rows.append(['Oscillation of a one-off delta', 'net tax, engine', f"{osc['net_engine']:.4f}",
                 f"legacy {osc['net_legacy']:.4f}"])
    values += [osc['net_engine'], osc['net_legacy']]
    for r in bm:
        rows.append(['Benchmark gain vs plan', f"N = {r['N']}, α = {r['alpha']:g}", fmt_pct(r['gain'], 2),
                     fmt_pct(r['plan'], 1)])
        values += [r['gain'], r['plan']]
    m = data['meta']
    cap = (f"Table UCC: Units are conserved. Round trip: a price rise then fall returns no more units than were paid "
           f"under the ratio-mirror rule (the legacy rule returns {get_key(data, 'p2b_round_trip_units')['legacy']:.3f}). "
           f"Oscillation: explicit annual flows reproduce the legacy settlement (max flow difference "
           f"{osc['max_flow_diff']:.1e}). Benchmark: single-life gains against the plan's quoted values. "
           f"N_val = {m['N_val']}."
           + ('' if data.get('p2_plan_fixture_applies', True)
              else ' The plan values are for the baseline calibration and do not apply at these parameters.'))
    return {'md': md_table(['Test', 'Item', 'Value', 'Reference'], rows, col_fmt=['left', 'left', 'center', 'left'])
            + '\n\n' + cap, 'values': values}


def _g2_cases(ex: dict):
    """Honest case first, then every other declaration ratio in ascending order."""
    ks = sorted(ex, key=float)
    honest = [k for k in ks if abs(float(k) - 1.0) < 1e-12]
    if not honest:
        raise KeyError('examples must include the honest case alpha = 1')
    return ex[honest[0]], [ex[k] for k in ks if k != honest[0]]


def build_WLG(data: dict, p: dict) -> dict:
    ex = get_key(data, 'examples')
    br = get_key(data, 'bridge')
    h, others = _g2_cases(ex)
    ah = h['decomposition']['alpha']
    heads = ['Year', 'True value V (£m)', f'Declared W, α = {ah:g}', 'Liability L', 'Units held f']
    for o in others:
        al = o['decomposition']['alpha']
        heads += [f'Declared W, α = {al:g}', 'Liability L', 'True value paid', 'Units held f', 'Units to state']
    rows, values = [], []
    for n, rh in enumerate(h['rows']):
        row = [f"**{rh['t']}**", f"{rh['V']:.2f}", f"{rh['W']:.2f}", f"{rh['L']:.3f}", f"{rh['f']:.4f}"]
        values += [rh['V'], rh['W'], rh['L'], rh['f']]
        for o in others:
            ra = o['rows'][n]
            row += [f"{ra['W']:.2f}", f"{ra['L']:.3f}", f"{ra['true_paid']:.3f}", f"{ra['f']:.4f}", f"{ra['s']:.4f}"]
            values += [ra['W'], ra['L'], ra['true_paid'], ra['f'], ra['s']]
        rows.append(row)
    d1 = h['decomposition']
    ds = [o['decomposition'] for o in others]
    lines = [('Holding-period payments, true value', 'holding_payments_true', '{:.2f}'),
             ('Sell-year cash', 'sell_year_cash', '{:+.2f}'),
             ('Post-sale settlement', 'post_sale_settlement', '{:+.2f}'),
             ('Terminal wealth, settled', 'TW_settled', '{:.2f}')]
    dec = md_table(['£m', f'α = {ah:g}'] + [f"α = {d['alpha']:g}" for d in ds],
                   [[lab] + [fm.format(d[k]) for d in [d1] + ds] for lab, k, fm in lines],
                   col_fmt=['left'] + ['center'] * (1 + len(ds)))
    worst = max(br['max_abs_diff'].values())
    als = ', '.join(f"{d['alpha']:g}" for d in ds)
    cap = (f"Table WLG: Worked ledger for an honest family and families declaring α = {als} of true value, single life, "
           f"N_val = {data['meta']['N_val']}. Declared value, liability and units are as the engine posts them; the "
           f"true value paid is the liability divided by α. The engine agrees with the legacy simulation to "
           f"{worst:.1e} (tolerance {br['tolerance']:.0e}).")
    return {'md': md_table(heads, rows, col_fmt=['center'] * len(heads)) + '\n\n' + dec + '\n\n' + cap,
            'values': values}


def _grid(cells: dict):
    ac = sorted({float(k.split('|')[0]) for k in cells})
    ad = sorted({float(k.split('|')[1]) for k in cells})
    return ac, ad


def build_CDS(data: dict, p: dict) -> dict:
    s = get_key(data, 'p3_surface')
    ac, ad = _grid(s['cells'])
    conf = {tuple(map(float, k.split('|'))) for k in s['conflict_cells']}

    def block(key):
        rows, vals = [], []
        for a in ac:
            row = [f'**{a:g}**']
            for b in ad:
                v = s['cells'][f'{a}|{b}'][key]
                mark = '*' if (a, b) in conf else ''
                row.append((fmt_pct(v, 1) if v is not None else 'n/a') + mark)
                if v is not None:
                    vals.append(v)
            rows.append(row)
        return md_table(['α_C \\ α_D'] + [f'{b:g}' for b in ad], rows), vals
    t1, v1 = block('gain')
    t2, v2 = block('pv_rel')
    cap = (f"Table CDS: Family terminal-wealth gain (top) and change in the PV of revenue to the state (bottom) by "
           f"declaration ratios α_C and α_D, λ = 0, no voluntary reset (a reset is a strategy action, not a rule). Cells marked * gain and "
           f"fall outside ±{fmt_pct(s['state_tol'], 1)} on PV: {len(conf)} of {len(s['cells']) - 1}. "
           f"T = {s['T']}, G = {s['G']}.")
    return {'md': 'Gain over honest\n\n' + t1 + '\n\nPV revenue change\n\n' + t2 + '\n\n' + cap, 'values': v1 + v2}


def build_RIS(data: dict, p: dict) -> dict:
    srch = get_key(data, 'p5.search')
    lams = get_key(data, 'p5.lambda_vals')
    rule = _chain(p, data)[-1]
    rs = get_key(data, 'p3_reset_sensitivity')
    cycles = list(srch[f'{rule}|{lams[0]}']['best_by_cycle'])
    heads1 = ['Voluntary reset cycle \\ λ'] + [f'{l:.0%}' for l in lams]
    rows1, values = [], []
    for c in cycles:
        row = [f'**{_lab_reset(c)}**']
        for l in lams:
            g = srch[f'{rule}|{l}']['best_by_cycle'][c]['gain']
            row.append(fmt_pct(g, 1))
            values.append(g)
        rows1.append(row)
    ivs = list(rs)
    ad = sorted(float(a) for a in rs[ivs[0]])
    rows2 = []
    for iv in ivs:
        row = [f'**{_lab_reset(iv)}**']
        for b in ad:
            g = rs[iv][str(b)]['gain']
            row.append(fmt_pct(g, 1))
            values.append(g)
        rows2.append(row)
    cap = (f"Table RIS: Voluntary Route D reset. (a) Best-response gain over the honest family by the family's own reset cycle and the "
           f"verification hazard λ, under {rule}; 'never' is the best of the strategies that do not reset. (b) Family gain from understating "
           f"Route D (α_D) by reset cycle, α_C = 1, λ = 0, against an honest family that never resets. A reset is an action the family "
           f"chooses, not a rule: it re-values Route D at the auction price and settles the accrued liability. "
           f"T = {p['val_gen']['T']}, G = {p['val_gen']['G']}.")
    return {'md': ('(a) Best response by reset cycle and λ\n\n' + md_table(heads1, rows1) +
                   '\n\n(b) Route D understatement by reset cycle\n\n' +
                   md_table(['Voluntary reset cycle \\ α_D'] + [f'{b:g}' for b in ad], rows2) + '\n\n' + cap),
            'values': values}


def build_DSH(data: dict, p: dict) -> dict:
    dil = get_key(data, 'p3_dilution')
    cs = get_key(data, 'p4_C_share_sensitivity')['cells']
    hv = get_key(data, 'p4_C_heavy_stress_gain')
    alphas = sorted(float(a) for a in next(iter(cs.values())))
    rows1 = [[f'**{float(k):.0%}**', fmt_pct(v, 3)] for k, v in dil.items()]
    values = list(dil.values())
    rows2 = []
    for key, row in cs.items():
        share, lam = key.split('|')
        cells = [f'**{share}, {lam.replace("lambda", "λ")}**']
        for a in alphas:
            cells.append(fmt_pct(row[str(a)]['gain'], 1))
            values.append(row[str(a)]['gain'])
        rows2.append(cells)
    rows3 = [[f'**{float(k):.0%}**', fmt_pct(v, 2)] for k, v in hv.items()]
    values += list(hv.values())
    cap = (f"Table DSH: Dilution and Route C share. (a) Gain from understating Route C only, by its share of wealth. "
           f"(b) Gain by α_C for each Route C share and λ, α_D = 1 (Route A absorbs the change in share). "
           f"(c) Gain in a Route-C-heavy mix, α_C = 0.5, by λ. T = {p['val_gen']['T']}, G = {p['val_gen']['G']}.")
    return {'md': ('(a) Dilution\n\n' + md_table(['Route C share', 'Gain'], rows1) +
                   '\n\n(b) Route C share sensitivity\n\n' +
                   md_table(['Route C share, λ'] + [f'α_C = {a:g}' for a in alphas], rows2) +
                   '\n\n(c) Route-C-heavy stress\n\n' + md_table(['λ', 'Gain'], rows3) + '\n\n' + cap),
            'values': values}


def _g6_years(p: dict, data: dict) -> list:
    T, G = p['val_gen']['T'], p['val_gen']['G']
    ys = list(range(G, T, G)) + [T]
    return [1] + ys


def build_VSY(data: dict, p: dict) -> dict:
    sw = get_key(data, 'p4_lambda_sweep')
    lams = [l for l in sw['by_lambda'] if float(l) > 0.0]
    ys = _g6_years(p, data)
    rows, values = [], []
    for y in ys:
        row = [f'**{y}**']
        for l in lams:
            v = sw['by_lambda'][l]['verified_share_by_year'][y - 1]
            row.append(fmt_pct(v, 1))
            values.append(v)
        rows.append(row)
    rows.append([f"**Year share ≥ {fmt_pct(sw['verified_threshold'], 0)}**"] +
                [str(sw['by_lambda'][l]['year_verified_share_ge_threshold']) for l in lams])
    cap = (f"Table VSY: Share of Route C units verified (corrective auction) by year, at each λ. Verified units are "
           f"declared at true value, so the share is 1 - (1 - λ)^t. The last row gives the first year the share "
           f"reaches the threshold. T = {p['val_gen']['T']}, G = {p['val_gen']['G']}.")
    return {'md': md_table(['Year'] + [f'λ = {float(l):.0%}' for l in lams], rows) + '\n\n' + cap, 'values': values}


BUILDERS.update({'UCC': build_UCC, 'WLG': build_WLG, 'CDS': build_CDS, 'RIS': build_RIS, 'DSH': build_DSH, 'VSY': build_VSY})



# ── DOMG dominance grid ──────────────────────────────────────────────────────

def build_DOMG(data: dict, p: dict) -> dict:
    dm = get_key(data, 'p5.dmg')['by_rule']
    th = get_key(data, 'p5.thresholds')
    heads = ['Rule set', 'Strategy', 'Smallest gain over scenarios', 'Mean gain']
    rows, values, notes = [], [], []
    for rule, d in dm.items():
        for r in d['dominant']:
            rows.append([f'**{rule}**', r['label'], fmt_pct(r['min_gain'], 3), fmt_pct(r['mean_gain'], 2)])
            values += [r['min_gain'], r['mean_gain']]
        notes.append(f"{rule}: {d['n_dominant']} of {d['n_strategies']} strategies gain in all {d['n_scenarios']} scenarios, "
                     f"{d['n_dominant_material']} by more than {fmt_pct(d['material_threshold'], 1)}")
    m = data['meta']
    cap = (f"Table DOMG: Strategies whose gain over the honest family is positive in every scenario "
           f"(growth by verification hazard, and a market fall by verification hazard), listed by rule set with the "
           f"smallest and the mean gain across scenarios, as a share of honest terminal wealth. Counts: "
           + '; '.join(notes) + f". The BRG tolerance is {fmt_pct(th['brg_tol'], 1)} (placeholder). "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'left', 'center', 'center']) + '\n\n' + cap, 'values': values}


# ── HERR honest valuation error ──────────────────────────────────────────────

def build_HERR(data: dict, p: dict) -> dict:
    hc = get_key(data, 'p5.hec')
    cells = hc['cells']
    heads = ['Rule set', 'λ', 'Error sd', 'Mean gain', '5th pct', '95th pct', 'Share of paths gaining', 'Mean state stake change']
    rows, values = [], []
    for c in cells.values():
        if c['sigma'] == 0.0:
            continue
        rows.append([f"**{c['rule']}**", fmt_pct(c['lambda'], 0), fmt_pct(c['sigma'], 0), fmt_pct(c['gain_mean'], 2),
                     fmt_pct(c['gain_p05'], 2), fmt_pct(c['gain_p95'], 2), fmt_pct(c['share_gaining'], 0),
                     fmt_pct(c['state_mean'], 2)])
        values += [c['gain_mean'], c['gain_p05'], c['gain_p95']]
    m = data['meta']
    pc, pd_ = hc.get('phi_C', hc['phi']), hc.get('phi_D', hc['phi'])
    phi_txt = f"{pc}" if pc == pd_ else f"Route C {pc}, Route D {pd_}"
    cap = (f"Table HERR: Terminal wealth of a family that values Routes C and D with honest error, against an error-free "
           f"honest family under the same rule set (positive = the error pays). Error is lognormal, correlated over time "
           f"(persistence {phi_txt}), independent across routes; {hc['paths']} paths per cell. "
           f"Error sd, persistence and path count are placeholders. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * 7) + '\n\n' + cap, 'values': values}


# ── UOS understatement against overstatement ────────────────────────────────

def build_UOS(data: dict, p: dict) -> dict:
    uo = get_key(data, 'p5.uos')
    shares = uo['c_share_vals']
    cells = uo['cells']
    blocks = []
    for c in cells.values():
        k = (c['rule'], c['lambda'])
        if k not in blocks:
            blocks.append(k)
    heads = ['Route C share'] + [f"{r}, λ = {fmt_pct(l, 0)}: {d}" for r, l in blocks for d in ('under', 'over')]
    rows, values = [], []
    for cs in shares:
        row = [fmt_pct(cs, 0)]
        for r, l in blocks:
            b = cells[f'{r}|{l}|{cs}']['best']
            for d in ('under', 'over'):
                row.append(fmt_pct(b[d]['gain'], 2))
                values.append(b[d]['gain'])
        rows.append(row)
    m = data['meta']
    cap = (f"Table UOS: Best gain over the honest family among strategies that only understate and among strategies "
           f"that only overstate, by Route C share of the asset base (Route A takes up the difference) and rule set, at "
           f"each verification hazard shown. Strategies that mix both directions are in the data file. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['center'] * len(heads)) + '\n\n' + cap, 'values': values}


# ── LGR single-life gain grid ────────────────────────────────────────────────

def build_LGR(data: dict, p: dict) -> dict:
    lf = get_key(data, 'life')
    alphas, gs = lf['alphas'], lf['g_vals']
    heads = ['α'] + [fmt_pct(g, 1) for g in gs]
    rows, values = [], []
    for a in alphas:
        row = [f'**{a}**']
        for g in gs:
            v = lf['grid'][f'{a}|{g}']['gain']
            row.append(fmt_pct(v, 1))
            values.append(v)
        rows.append(row)
    cap = (f"Table LGR: Single life, Route C: change in terminal wealth against honest declaration (positive = the "
           f"declarer retains more), by declaration ratio α (rows) and asset growth g (columns), after a holding period "
           f"of {lf['N']} years and sale. Terminal wealth includes post-sale settlement.")
    return {'md': md_table(heads, rows, col_fmt=['center'] * len(heads)) + '\n\n' + cap, 'values': values}


BUILDERS.update({'DOMG': build_DOMG, 'HERR': build_HERR, 'UOS': build_UOS, 'LGR': build_LGR})



# ── LNS single-life holding-period sweep ─────────────────────────────────────

def build_LNS(data: dict, p: dict) -> dict:
    lf = get_key(data, 'life')
    alphas, ns = lf['alphas'], lf['n_vals']
    heads = ['α'] + [str(n) for n in ns]
    rows, values = [], []
    for a in alphas:
        row = [f'**{a}**']
        for n in ns:
            v = lf['by_n'][f'{a}|{n}']['gain']
            row.append(fmt_pct(v, 1))
            values.append(v)
        rows.append(row)
    cap = (f"Table LNS: Single life, Route C, constant asset growth {fmt_pct(lf['g0'], 1)}: change in terminal wealth against "
           f"honest declaration (positive = the declarer retains more), by declaration ratio α (rows) and holding period in "
           f"years (columns). Terminal wealth includes post-sale settlement.")
    return {'md': md_table(heads, rows, col_fmt=['center'] * len(heads)) + '\n\n' + cap, 'values': values}


BUILDERS.update({'LNS': build_LNS})


# ── S5 (Work Order): replay, archetypes, breakeven, rho, lambda grid, V0 bands, HLC pair ──────────────────────────────────
# Every table below reads keys valgen_core already writes: replay, p6, rho, p3_lambda_grid, v0_sweep, p5.hlc_pair, p5.search.
# A section the core skipped (no replay, no archetypes, no RATES JSON) builds a one-line note instead of failing the run.

def _skipped(d) -> bool:
    return (not d) or (isinstance(d, dict) and bool(d.get('skipped')))


def _not_built(pid: str, why: str) -> dict:
    return {'md': f'Table {pid}: not built. {why}', 'values': []}


def _split_key(key: str):
    """'rule|lambda' -> (rule, float lambda). Rule keys contain '/' but never '|'."""
    rule, lam = key.rsplit('|', 1)
    return rule, float(lam)


_MODE_LABEL = {'sale': 'Sale', 'lien': 'Lien', 'income': 'Income'}


# ── RPL JST replay ───────────────────────────────────────────────────────────

def build_RPL(data: dict, p: dict) -> dict:
    rp = data.get('replay')
    if _skipped(rp):
        return _not_built('RPL', 'The JST replay was skipped (replay_stride = 0 or no replay_countries in [val_gen]).')
    th = get_key(data, 'p5.thresholds')
    heads = ['Country', 'Rule set', 'λ', 'Windows', 'Number', 'BRG pass', 'SST pass', 'Median gain', 'Max gain']
    rows, values, counts = [], [], []
    for iso, c in rp['countries'].items():
        ncont = sum(1 for r in c['rows'] if r['contiguous'])
        counts.append(f"{iso}: {c['usable_years']} usable years, {c['windows']} windows, {ncont} contiguous, "
                      f"{c['repeat_windows']} with repeated years")
        for key, sm in c['summary'].items():
            rule, lam = _split_key(key)
            for nm, lab in (('full_loop', 'Full loop'), ('contiguous', 'Contiguous')):
                s = sm[nm]
                if s is None:
                    rows.append([iso, f'**{rule}**', f'{lam:.0%}', lab, '0', 'n/a', 'n/a', 'n/a', 'n/a'])
                    continue
                rows.append([iso, f'**{rule}**', f'{lam:.0%}', lab, str(s['windows']), fmt_pct(s['BRG_pass_share'], 0),
                             fmt_pct(s['SST_pass_share'], 0), fmt_pct(s['gain_median'], 1), fmt_pct(s['gain_max'], 1)])
                values += [s['BRG_pass_share'], s['SST_pass_share'], s['gain_median'], s['gain_max']]
    m = data['meta']
    cap = (f"Table RPL: The headline rule sets on the real JST capital-return path of each loop window ({rp['T']} years, every "
           f"{rp['stride']}th start year). The history wraps, so a window that crosses the seam repeats years: it is in the full "
           f"loop but not in the contiguous set. Share of windows passing BRG (best-response gain at most {fmt_pct(th['brg_tol'], 1)}) "
           f"and SST (state stake within ±{fmt_pct(th['state_tol'], 1)}), and the median and largest best-response gain over the "
           f"strategy library. {'; '.join(counts)}. Windows overlap, so they are not independent draws. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'left', 'center', 'left'] + ['center'] * 5) + '\n\n' + cap,
            'values': values}


# ── ARC archetypes ───────────────────────────────────────────────────────────

def _arc_data(data: dict):
    arch = (data.get('p6') or {}).get('archetypes')
    if not arch:
        return None, None, None
    first = next(iter(arch.values()))
    modes = list(first['modes'])
    lams = sorted({float(k) for k in first['modes'][modes[0]]['best']})
    return arch, modes, lams


def build_ARC(data: dict, p: dict) -> dict:
    arch, modes, lams = _arc_data(data)
    if arch is None:
        return _not_built('ARC', 'valgen_core found no [archetypes] / [route_b] blocks in the parameter file.')
    heads = ['Archetype', 'V0', 'Route B mode', 'Honest terminal wealth (£m)', 'State PV (£m)', 'Income paid (£m)'] + \
        [f'Best response, λ = {l:.0%}' for l in lams]
    rows, values = [], []
    for name, a in arch.items():
        for mode in modes:
            c = a['modes'][mode]
            row = [f"**{a['label']}**", f"£{a['V0_m']:g}m", _MODE_LABEL.get(mode, mode), f"{c['TW']:,.1f}", f"{c['PV']:,.1f}",
                   f"{c['income_paid']:,.1f}"]
            values += [c['TW'], c['PV'], c['income_paid']]
            for l in lams:
                b = c['best'][str(l)]
                row.append(f"{fmt_pct(b['gain'], 1)} {'pass' if b['BRG'] else 'FAIL'} ({b['label']})")
                values.append(b['gain'])
            rows.append(row)
    th = get_key(data, 'p5.thresholds')
    shares = '; '.join(f"{a['label']}: " + ' '.join(f"{k} {v:.0%}" for k, v in a['shares'].items()) for a in arch.values())
    m = data['meta']
    cap = (f"Table ARC: The five archetypes through the family engine under the candidate rule set, with Route B settled by sale, "
           f"by a deferred lien and from external income. Honest terminal wealth and the present value of the state's receipts are "
           f"true £m; income paid is the cumulative external income the state received. Best response is the best of the "
           f"{data['p5']['n_strategies']}-strategy library (a lower bound), with the BRG verdict at {fmt_pct(th['brg_tol'], 1)}. "
           f"Route shares: {shares}. Shares, income ratios and the deferral spread are placeholders. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'center', 'left'] + ['center'] * (len(heads) - 3)) + '\n\n' + cap,
            'values': values}


# ── BES breakeven deferral spread ────────────────────────────────────────────

def build_BES(data: dict, p: dict) -> dict:
    arch, _modes, _lams = _arc_data(data)
    if arch is None:
        return _not_built('BES', 'valgen_core found no [archetypes] / [route_b] blocks in the parameter file.')
    rb = p.get('route_b') or {}
    toml_sp = rb.get('deferral_spread')
    heads = ['Archetype', 'V0', 'Breakeven spread'] + (['Placeholder spread', 'Placeholder against breakeven'] if toml_sp is not None else [])
    rows, values = [], []
    for name, a in arch.items():
        be = a['breakeven_spread']
        row = [f"**{a['label']}**", f"£{a['V0_m']:g}m", 'not bracketed in [-4%, +30%]' if be is None else f'{be:+.2%}']
        if be is not None:
            values.append(be)
        if toml_sp is not None:
            row.append(f'{toml_sp:+.2%}')
            values.append(toml_sp)
            row.append('n/a' if be is None else ('above' if toml_sp > be else 'below'))
        rows.append(row)
    m = data['meta']
    sov = rb.get('sovereign_real_rate')
    cap = (f"Table BES: Breakeven deferral spread by archetype: the spread over the sovereign real rate"
           + (f" ({fmt_pct(sov, 2)})" if sov is not None else '')
           + f" at which the present value of the state's receipts under the Route B lien equals its value under sale, "
           f"at ρ = {fmt_pct(data['rho']['base'], 1)}. At a spread above the breakeven the lien is worth more to the state than a sale. "
           f"Solved by bisection; 'not bracketed' means no spread in the range makes the two equal. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'center'] + ['center'] * (len(heads) - 2)) + '\n\n' + cap, 'values': values}


# ── RSP rho and the SPT sensitivity ──────────────────────────────────────────

def _rsp_grid(data: dict, p: dict):
    vg = p['val_gen']
    lams = [0.0, vg['lambda_base']]
    rules = list(vg['headline_rules'])
    srch = get_key(data, 'p5.search')
    spt = get_key(data, 'rho.spt_by_rho')
    rho_keys = sorted(next(iter(spt.values())), key=float)
    cells = []
    for rule in rules:
        for lam in lams:
            k = f'{rule}|{lam}'
            cells.append({'rule': rule, 'lam': lam, 'sst': srch[k]['n_conflict_sst'], 'sst_ok': srch[k]['SST_pass'],
                          'spt': [(float(r), spt[k][r]['n_conflict'], spt[k][r]['pass']) for r in rho_keys]})
    return cells, [float(r) for r in rho_keys]


def build_RSP(data: dict, p: dict) -> dict:
    cells, rhos = _rsp_grid(data, p)
    heads = ['Rule set', 'λ', 'SST (primary)'] + [f'SPT, ρ = {r:.1%}' for r in rhos]
    rows, values = [], []
    for c in cells:
        row = [f"**{c['rule']}**", f"{c['lam']:.0%}", f"{c['sst']} {'pass' if c['sst_ok'] else 'FAIL'}"]
        values.append(c['sst'])
        for _r, n, ok in c['spt']:
            row.append(f"{n} {'pass' if ok else 'FAIL'}")
            values.append(n)
        rows.append(row)
    th = get_key(data, 'p5.thresholds')
    m = data['meta']
    cap = (f"Table RSP: Number of gaining strategies that leave the state outside ±{fmt_pct(th['state_tol'], 1)}, by test. SST, the "
           f"state's terminal stake, does not depend on the discount rate and is the primary state test. SPT, the present value of "
           f"the state's receipts, is shown at each ρ in the sweep (base ρ = {fmt_pct(data['rho']['base'], 1)}). A cell passes when the "
           f"count is zero. {data['p5']['n_strategies']}-strategy library. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left', 'center'] + ['center'] * (len(heads) - 2)) + '\n\n' + cap, 'values': values}


# ── LCD lambda_C x lambda_D ──────────────────────────────────────────────────

def build_LCD(data: dict, p: dict) -> dict:
    g = get_key(data, 'p3_lambda_grid')
    lc, ld = g['lambda_C'], g['lambda_D']
    cells = g['cells']
    heads = ['λ_C \\ λ_D'] + [f'{b:.0%}' for b in ld]
    r1, r2, values = [], [], []
    for a in lc:
        row1, row2 = [f'**{a:.0%}**'], [f'**{a:.0%}**']
        for b in ld:
            c = cells[f'{a}|{b}']
            row1.append(fmt_pct(c['gain'], 1) + ('' if c['BRG'] else '*'))
            row2.append(c['label'])
            values.append(c['gain'])
        r1.append(row1)
        r2.append(row2)
    th = get_key(data, 'p5.thresholds')
    m = data['meta']
    cap = (f"Table LCD: Best-response gain over the honest family (top) and the strategy that achieves it (bottom), with the Route C "
           f"verification hazard λ_C and the Route D corrective-auction hazard λ_D varied independently, under {g['rule']}. "
           f"Cells marked * exceed the BRG threshold of {fmt_pct(th['brg_tol'], 1)}. Best of the strategy library: a lower bound. "
           f"T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': 'Best-response gain\n\n' + md_table(heads, r1) + '\n\nStrategy\n\n' + md_table(heads, r2) + '\n\n' + cap,
            'values': values}


# ── BAND V0 sweep across the RATES revenue bands ─────────────────────────────

def build_BAND(data: dict, p: dict) -> dict:
    v = get_key(data, 'v0_sweep')
    bands, rules, lams, cells = v['bands'], v['rules'], v['lambda_vals'], v['cells']
    combos = [(r, l) for r in rules for l in lams]
    heads = ['V0 (£m)'] + [f'{r}, λ = {l:.0%}: best gain' for r, l in combos] + [f'{r}: honest tax drag' for r in rules]
    rows, values = [], []
    for b in bands:
        row = [f'**{b:g}**']
        for r, l in combos:
            c = cells[f'{b}|{r}|{l}']
            row.append(f"{fmt_pct(c['gain'], 1)} {'pass' if c['BRG'] else 'FAIL'}")
            values.append(c['gain'])
        for r in rules:
            d = cells[f'{b}|{r}|{lams[0]}']['drag']
            row.append(fmt_pct(d, 1))
            values.append(d)
        rows.append(row)
    th = get_key(data, 'p5.thresholds')
    m = data['meta']
    cap = (f"Table BAND: Launch wealth V0 swept across the RATES revenue bands. Best-response gain over the honest family by rule set "
           f"and λ, with the BRG verdict at {fmt_pct(th['brg_tol'], 1)}, and the honest family's tax drag: one minus its terminal wealth "
           f"over the terminal wealth of a run with no tax. Route shares stay at the baseline mix; the archetype mixture by band is a "
           f"RATES output. {v['note'].split(';')[0]}. T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['left'] + ['center'] * (len(heads) - 1)) + '\n\n' + cap, 'values': values}


# ── HLP headline contrast: the pair (average payer, top payer) ───────────────

def build_HLP(data: dict, p: dict) -> dict:
    hp = data['p5'].get('hlc_pair')
    if _skipped(hp):
        why = hp.get('reason') if isinstance(hp, dict) else None
        return _not_built('HLP', (why or 'the RATES JSON was not available when valgen_core ran') + '. Run rates_core.py, then valgen_core.py.')
    hl = get_key(data, 'p5.headline')
    cand = hl['rules'][-1]
    lam_b = p['val_gen']['lambda_base']
    lams = [0.0, lam_b]
    avg, top = hp['burdens']['average'], hp['burdens']['top']
    alphas = [a for a in sorted(hl['alphas'], reverse=True) if a <= 1.0]
    heads = ['Declaration ratio α', f"Conventional, average payer ({fmt_pct(avg['rate'], 3)} a year)",
             f"Conventional, top payer ({fmt_pct(top['rate'], 3)} a year)"] + [f'WDT {cand}, λ = {l:.0%}' for l in lams]
    rows, values = [], []
    for a in alphas:
        row = [f'**{a:g}**', fmt_pct(avg['diag_alpha'][str(a)], 1), fmt_pct(top['diag_alpha'][str(a)], 1)]
        values += [avg['diag_alpha'][str(a)], top['diag_alpha'][str(a)]]
        for l in lams:
            gv = hl['by_rule'][cand][str(l)][str(a)]['gain']
            row.append(fmt_pct(gv, 1) if gv is not None else 'n/a')
            if gv is not None:
                values.append(gv)
        rows.append(row)
    m = data['meta']
    src = hp['source']
    cap = (f"Table HLP: Gain over the honest family by declaration ratio α, for a conventional self-declared flat tax set at the annual "
           f"burden the WDT puts on the average payer ({fmt_pct(avg['rate'], 3)}) and on the top payer ({fmt_pct(top['rate'], 3)}), against the "
           f"WDT best response under {cand}. Burdens are the wealth-weighted stock rates of RATES scenario {src['scenario']}, read from "
           f"the RATES JSON. Conventional: no audits modelled. WDT: best response over every strategy that deviates at exactly that α, a "
           f"lower bound. α = 0 is undefined for the WDT (zero declared price). T = {m['params']['T']}, G = {m['params']['G']}.")
    return {'md': md_table(heads, rows, col_fmt=['center'] * len(heads)) + '\n\n' + cap, 'values': values}


BUILDERS.update({'RPL': build_RPL, 'ARC': build_ARC, 'BES': build_BES, 'RSP': build_RSP, 'LCD': build_LCD,
                 'BAND': build_BAND, 'HLP': build_HLP})


def main(only=None) -> None:
    p = load_params()
    data = load_data()
    _check_stamp(data, p)
    ensure_dir(_OUT)
    combined = MdDoc()
    for pid, spec in PAIRS.items():
        if only and pid not in only:
            continue
        res = BUILDERS[pid](data, p)
        path = _OUT / f"val_table_{pid}_{spec['slug']}.md"
        doc = MdDoc()
        doc.add_block(res['md'])
        doc.write(path)
        if len(combined):
            combined.blank().rule().blank()
        combined.h2(f"{spec['title']} ({pid})").blank().add_block(res['md'])
    if len(combined):
        combined.write(_OUT / 'val_tables_all.md')
    if not only:
        write_names(p)


def write_names(p: dict) -> None:
    """Acronym register generated from [names.val]; ordered by kind then acronym."""
    order = ['claim', 'test', 'output', 'example', 'rule', 'component', 'metric', 'step']
    rows = []
    for k in order:
        for a, v in p['names_val'].items():
            if v['kind'] == k:
                rows.append([f"**{a}**", k, v['name'], v['legacy'] or '', v['note']])
    doc = MdDoc()
    doc.add_block(md_table(['Acronym', 'Kind', 'Name', 'Legacy id', 'Meaning'], rows))
    doc.write(_OUT / 'val_names.md')


if __name__ == '__main__':
    main(only=sys.argv[1:] or None)
