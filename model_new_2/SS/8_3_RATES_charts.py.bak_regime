"""
8_3_RATES_charts.py — RATES figures (placeholders; edit as you decide what you want)
====================================================================================
Reads OUTPUTS/RATES/rates_data.json and writes OUTPUTS/RATES/charts/rates_fig_{n}_{slug}.png.
Figure n has a matching table n in 8_2_RATES_tables.py: same number, same slug.

No simulation, no import of rates_core. Which scenario and index mode each figure reads is
set in WDT_Params.toml [rates.figures]. Every figure function takes (data, p) and returns
the path it wrote. To add a figure: write the function, add it to FIGURES, and add the
matching table in 8_2_RATES_tables.py (rates_test.py checks the registries agree).

Figures 1-8 read the main scenario. Figures 9-12 present the hybrid design:
  9  schedule_grid    traditional tax still needed, and realised burden, by schedule
  10 cohorts          homogeneous base against the two cohort variants
  11 schedule_curves  the rate schedules side by side
  12 scope            who is above W_min at launch
Figures 13-16 present the headline:
  13 cover_by_country share of reference expenditure covered, by country, with and without the CORP levy
  14 lever_stack      the cumulative stack: what each lever adds, levy off / real-basis / nominal-basis
  15 frontier         spending covered against realised burden, every design
  16 revenue_by_tier  where the revenue comes from, by launch-wealth band
  17 tax_replacement  median relief split into the taxes it retires and what is left for the two tax-free thresholds
  18 threshold_by_country  the tax-free threshold each country's relief could reach, all countries on one chart
  19 threshold_by_schedule  the tax-free threshold under each WDT rate schedule, and the tax a person saves by income

Relief and coverage are medians over windows in which the fund fills; receipts, burden, drift and tier shares
are medians over all windows (wc.scenario_medians).

Any per-window column is available: headline.overall.medians holds the median of every
numeric column, and the baseline scenario stores every window (wc.table_to_frame).

    python 8_3_RATES_charts.py
"""

import sys
from pathlib import Path

import numpy as np

# wdt_* modules and WDT_Params.toml live in Model/, one level above this RATES folder
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import wdt_core as wc
from wdt_fmt import band_labels, ensure_dir, out_dir, group_label, thr_head
from wdt_style import (C_ANNOTATION, C_BASELINE, C_DARK, C_LRR, C_SSM, C_SURPLUS, C_TCM,
                       FIG_PAIR, FIG_SINGLE, FIG_WIDE, FIG_TRIPLE, apply_style, save_fig)

CODE = 'RATES'


# ── helpers ──────────────────────────────────────────────────────────────────

def _plt():
    import matplotlib.pyplot as plt
    return plt


def _scen(data, name):
    """Scenario block, with a clear message if it has not been run."""
    try:
        return data['scenarios'][name]
    except KeyError:
        raise SystemExit(f"scenario '{name}' is not in rates_data.json; run: "
                         f"python rates_core.py --scenario {name}")


def _ctx(data, p, name=None):
    fg = p['rates']['figures']
    sc = _scen(data, name or fg['scenario'])
    mode = fg['mode']
    return sc, mode, sc['headline'][mode]


def _med(sc, mode):
    """Medians for a scenario at `mode`, or at the one mode it ran (the house-index scenario)."""
    hl = sc['headline']
    return hl[mode if mode in hl else next(iter(hl))]['overall']['medians']


def _title(sc, mode, what):
    return f"{what}\n{sc['label']}, index {mode}"


def _nan(x):
    return np.nan if x is None else float(x)


def _pct(ax, axis='x', decimals=1):
    from matplotlib.ticker import PercentFormatter
    (ax.xaxis if axis == 'x' else ax.yaxis).set_major_formatter(PercentFormatter(1.0, decimals=decimals))


def _path(n, slug):
    return ensure_dir(out_dir(CODE) / 'charts') / f'rates_fig_{n}_{slug}.png'


def _wrap(label, width=18):
    """Break a scenario label over lines for tick labels."""
    words, lines, cur = label.split(), [], ''
    for w in words:
        if len(cur) + len(w) + 1 > width and cur:
            lines.append(cur)
            cur = w
        else:
            cur = f'{cur} {w}'.strip()
    return '\n'.join(lines + [cur])

def _burden_panels(ax_s, ax_g, ma, x, grp, top):
    """Grouped bars of realised stock rate and gain rate: wealth-weighted payers beside the top group."""
    w = 0.38
    for ax, key, dec in ((ax_s, 'stock', 2), (ax_g, 'gain', 0)):
        ax.bar(x - w / 2, [_nan(v.get(f'er_{key}_{grp}')) for v in ma], w, color=C_SSM, label=group_label(grp))
        ax.bar(x + w / 2, [_nan(v.get(f'er_{key}_{top}')) for v in ma], w, color=C_TCM, label=group_label(top))
        ax.set_ylabel(f'Realised {key} rate per year')
        ax.set_title(f'{key.capitalize()} rate (wealth-weighted)')
        ax.legend()
        _pct(ax, 'y', dec)


_CASE_TXT = {'real': 'a real-basis levy', 'nominal': 'the nominal-basis levy', 'none': 'no levy'}


# ── figures 1-8 ──────────────────────────────────────────────────────────────

def f1_relief_by_country(data, p):
    """Relief paid over the horizon, % of GDP, by country (median with p10-p90)."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    items = sorted(h['by_country'].items(), key=lambda kv: _nan(kv[1]['relief_gdp']['p50']))
    isos = [k for k, _ in items]
    med = np.array([_nan(b['relief_gdp']['p50']) for _, b in items])
    lo = np.array([_nan(b['relief_gdp']['p10']) for _, b in items])
    hi = np.array([_nan(b['relief_gdp']['p90']) for _, b in items])
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.barh(isos, med, color=C_SSM, xerr=[med - lo, hi - med], ecolor=C_DARK, capsize=2)
    ax.set_xlabel('Relief paid, share of GDP (median, bars p10-p90)')
    ax.set_title(_title(sc, mode, 'Relief paid after fund fill, by country'))
    _pct(ax)
    return save_fig(fig, _path(1, 'relief_by_country'))


def f2_coverage_denominators(data, p):
    """Coverage against each country's own spending vs the fixed reference spending."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    items = sorted(h['by_country'].items(), key=lambda kv: _nan(kv[1]['coverage']['p50']))
    isos = [k for k, _ in items]
    own = np.array([_nan(b['coverage']['p50']) for _, b in items])
    ref = np.array([_nan(b['cov_ref']['p50']) for _, b in items])
    y = np.arange(len(isos))
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.hlines(y, ref, own, color=C_ANNOTATION, lw=1)
    ax.scatter(own, y, color=C_TCM, label='Own-country spending', zorder=3)
    ax.scatter(ref, y, color=C_SSM, label=f"Reference spending ({sc['calibration']['exp_ref']:.0%} of GDP)", zorder=3)
    ax.set_yticks(y, isos)
    ax.set_xlabel('Share of expenditure covered by relief (median)')
    ax.set_title(_title(sc, mode, 'Coverage depends on the spending denominator'))
    ax.legend()
    _pct(ax)
    return save_fig(fig, _path(2, 'coverage_denominators'))


def f3_revenue_components(data, p):
    """Receipt components (holding-year tax, heir receipts, refunds) per scenario."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    names = fg['decomposition']
    labels = [_scen(data, n)['label'] for n in names]
    med = [wc.scenario_medians(_scen(data, n), mode, all_windows=True) for n in names]
    tax = np.array([m['tax_gdp_mean'] for m in med])
    heir = np.array([m['heir_gdp_mean'] for m in med])
    ref = np.array([m['refund_gdp_mean'] for m in med])
    net = np.array([m['net_gdp_mean'] for m in med])
    x = np.arange(len(names))
    fig, ax = _plt().subplots(figsize=FIG_WIDE)
    ax.bar(x, tax, color=C_SSM, label='Holding-year tax')
    ax.bar(x, heir, bottom=tax, color=C_SURPLUS, label='Heir receipts')
    lev = np.array([m['levy_gdp_mean'] for m in med])
    ax.bar(x, lev, bottom=tax + heir, color=C_TCM, label='Corporate levy (unattributed)')
    ax.bar(x, ref, color=C_BASELINE, label='Refunds')
    ax.scatter(x, net, color=C_DARK, zorder=3, label='Net (median)')
    ax.axhline(0, color=C_ANNOTATION, lw=0.8)
    ax.set_xticks(x, [l.replace(' (', '\n(') for l in labels], fontsize=8)
    ax.set_ylabel('Share of GDP, median over windows')
    ax.set_title(f'Where the receipts come from, index {mode}')
    ax.legend()
    _pct(ax, 'y')
    return save_fig(fig, _path(3, 'revenue_components'))


def f4_rate_grid(data, p):
    """Revenue and burden for tau_0 x k combinations: relief, stock rate and gain rate, payers and top group."""
    apply_style()
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    names = fg['rate_grid']
    labels = [f"tau_0 {_scen(data, n)['cfg']['tau_0']:.0%}\nk {_scen(data, n)['cfg']['k_per_gbp_m']:g}" for n in names]
    m = [_scen(data, n)['headline'][mode]['overall']['medians'] for n in names]
    ma = [wc.scenario_medians(_scen(data, n), mode, all_windows=True) for n in names]
    x = np.arange(len(names))
    fig, (a1, a2, a3) = _plt().subplots(1, 3, figsize=FIG_TRIPLE)
    a1.bar(x, [v['relief_gdp'] for v in m], color=C_LRR)
    a1.set_title('Relief paid (share of GDP)')
    _pct(a1, 'y')
    _burden_panels(a2, a3, ma, x, grp, top)
    for ax in (a1, a2, a3):
        ax.set_xticks(x, labels, fontsize=8)
    fig.suptitle(f'Revenue against burden, index {mode}')
    return save_fig(fig, _path(4, 'rate_grid'))


def f5_drift(data, p):
    """Is the tax base stable? Relief against drift, every window."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    if 'windows' not in sc:
        raise KeyError(f"scenario '{sc['label']}' has no stored windows: set store_windows = true")
    df = wc.table_to_frame(sc['windows'])
    df = df[(df['mode'] == mode) & (~df['censored'].astype(bool))]
    lo, hi = p['rates']['run']['drift_band']
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.scatter(df['drift'], df['relief_gdp'], s=12, alpha=0.5, color=C_SSM)
    ax.axvspan(lo, hi, color=C_LRR, alpha=0.12, label='Stable base')
    ax.axvline(1.0, color=C_ANNOTATION, lw=0.8)
    ax.set_xlabel('Wealth/GDP at window end ÷ launch')
    ax.set_ylabel('Relief paid, share of GDP')
    ax.set_title(_title(sc, mode, 'Relief against tax-base drift (one dot per window)'))
    ax.legend()
    _pct(ax, 'y')
    return save_fig(fig, _path(5, 'drift'))


def f6_by_era(data, p):
    """Censoring, failure and fill year by era."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    eras = list(h['by_era'])
    b = [h['by_era'][e] for e in eras]
    x = np.arange(len(eras))
    fig, (a1, a2) = _plt().subplots(1, 2, figsize=FIG_PAIR)
    w = 0.38
    a1.bar(x - w / 2, [_nan(v['censored_share']) for v in b], w, color=C_TCM, label='Censored')
    a1.bar(x + w / 2, [_nan(v['fail_share']) for v in b], w, color=C_BASELINE, label='Fail')
    a1.set_xticks(x, eras)
    a1.set_title('Censored and failing windows')
    a1.legend()
    _pct(a1, 'y')
    a2.bar(x, [_nan(v['fill_year']['p50']) for v in b], color=C_LRR)
    a2.set_xticks(x, eras)
    a2.set_ylabel('Median LRR fill year')
    a2.set_title('Time to fill the reserves')
    fig.suptitle(_title(sc, mode, 'Fund outcomes by era of start year'))
    return save_fig(fig, _path(6, 'by_era'))


def f7_rate_curve(data, p):
    """The rate schedule of the main scenario: rate against wealth."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    rc = sc['calibration']['rate_curve']
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.plot(rc['W_gbp_m'], rc['tau'], marker='o', color=C_SSM)
    ax.set_xscale('log')
    ax.set_xlabel('Wealth W (£m, log scale)')
    ax.set_ylabel('Rate on the delta, tau(W)')
    ax.set_ylim(0, 1)
    ax.set_title(_title(sc, mode, 'WDT rate schedule'))
    _pct(ax, 'y')
    return save_fig(fig, _path(7, 'rate_curve'))


def f8_closure(data, p):
    """How many times larger would the tax base need to be to replace the target revenue?"""
    apply_style()
    sc, mode, h = _ctx(data, p)
    items = sorted(h['by_country'].items(), key=lambda kv: _nan(kv[1]['base_multiple_needed']['p50']))
    isos = [k for k, _ in items]
    med = np.array([_nan(b['base_multiple_needed']['p50']) for _, b in items])
    lo = np.array([_nan(b['base_multiple_needed']['p10']) for _, b in items])
    hi = np.array([_nan(b['base_multiple_needed']['p90']) for _, b in items])
    rep = data['meta']['closure_replaced_tax_gdp']
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.barh(isos, med, color=C_SURPLUS, xerr=[med - lo, hi - med], ecolor=C_DARK, capsize=2)
    ax.axvline(1.0, color=C_BASELINE, lw=1.2, label='Break-even (base multiple = 1)')
    ax.set_xlabel(f'Base multiple needed to replace revenue worth {rep:.0%} of GDP (median, bars p10-p90)')
    ax.set_title(_title(sc, mode, 'Closure test'))
    ax.legend()
    return save_fig(fig, _path(8, 'closure'))


# ── figures 9-12: the hybrid design ──────────────────────────────────────────

def f9_schedule_grid(data, p):
    """Spending covered (left) and realised burden by schedule: payers beside the top group (middle, right)."""
    apply_style()
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    scs = [_scen(data, n) for n in fg['schedules']]
    m = [_med(s, mode) for s in scs]                                    # fund fills: coverage
    ma = [wc.scenario_medians(s, mode, all_windows=True) for s in scs]  # all windows: burden
    labels = [_wrap(s['label']) for s in scs]
    x = np.arange(len(scs))
    fig, (a1, a2, a3) = _plt().subplots(1, 3, figsize=FIG_TRIPLE)
    a1.bar(x, [_nan(v.get('cov_ref')) for v in m], color=C_LRR)
    a1.set_title('Spending covered (relief / reference expenditure)')
    _pct(a1, 'y', 0)
    _burden_panels(a2, a3, ma, x, grp, top)
    for ax in (a1, a2, a3):
        ax.set_xticks(x, labels, fontsize=6)
    fig.suptitle(f'Hybrid design by rate schedule, index {mode}')
    return save_fig(fig, _path(9, 'schedule_grid'))


def f10_cohorts(data, p):
    """Net receipts and relief: homogeneous base against the cohort variants."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    names = fg['cohorts']
    scs = [_scen(data, n) for n in names]
    m = [_med(s, mode) for s in scs]
    ma = [wc.scenario_medians(s, mode, all_windows=True) for s in scs]
    x = np.arange(len(names))
    w = 0.38
    fig, ax = _plt().subplots(figsize=FIG_WIDE)
    ax.bar(x - w / 2, [_nan(v.get('net_gdp_mean')) for v in ma], w, color=C_SSM, label='Net receipts')
    ax.bar(x + w / 2, [_nan(v.get('relief_gdp')) for v in m], w, color=C_LRR, label='Relief paid')
    ax.set_xticks(x, [_wrap(s['label'], 18) for s in scs], fontsize=7)
    ax.set_ylabel('Share of GDP, median over windows')
    ax.set_title(f'Net receipts and relief by return model, index {mode}')
    ax.legend()
    _pct(ax, 'y', 2)
    return save_fig(fig, _path(10, 'cohorts'))


def f11_schedule_curves(data, p):
    """The rate schedules on one set of axes."""
    apply_style()
    fg = p['rates']['figures']
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    for n in fg['schedules']:
        s = _scen(data, n)
        rc = s['calibration']['rate_curve']
        ax.plot(rc['W_gbp_m'], rc['tau'], marker='o', ms=3, label=s['label'])
    ax.set_xscale('log')
    ax.set_xlabel('Wealth W (£m, log scale)')
    ax.set_ylabel('Rate on the delta, tau(W)')
    ax.set_ylim(0, 1)
    ax.set_title('Rate schedules compared')
    ax.legend(fontsize=7)
    _pct(ax, 'y', 0)
    return save_fig(fig, _path(11, 'schedule_curves'))


def f12_scope(data, p):
    """Adults and wealth above W_min at launch."""
    apply_style()
    fg = p['rates']['figures']
    scs = [_scen(data, n) for n in fg['scope']]
    scs = [s for s in scs if s['calibration'].get('scope')]
    x = np.arange(len(scs))
    w = 0.38
    fig, ax = _plt().subplots(figsize=FIG_SINGLE)
    ax.bar(x - w / 2, [s['calibration']['scope']['adult_share'] for s in scs], w, color=C_SSM, label='Adults')
    ax.bar(x + w / 2, [s['calibration']['scope']['wealth_share'] for s in scs], w, color=C_SURPLUS, label='Wealth')
    ax.set_xticks(x, [_wrap(s['label'], 22) for s in scs], fontsize=8)
    ax.set_ylim(0, 1.05)
    ax.set_title('Share above W_min at launch')
    ax.legend()
    _pct(ax, 'y', 0)
    return save_fig(fig, _path(12, 'scope'))


# ── figures 13-16: the headline ──────────────────────────────────────────────

def f13_cover_by_country(data, p):
    """Share of reference expenditure covered, by country, one marker per headline scenario (median, p10-p90): with the levy and without it."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    names, labs = fg['headline'], fg['headline_names']
    scs = [_scen(data, n) for n in names]
    nom = [wc.levy_headline(s, mode, 'nominal') for s in scs]
    non = [wc.levy_headline(s, mode, 'none') for s in scs]
    order = sorted(nom[0]['by_country'], key=lambda i: _nan(nom[0]['by_country'][i]['cov_ref']['p50']))
    rows = order + ['All']
    y = np.arange(len(rows))
    off = np.linspace(-0.22, 0.22, len(names))
    cols = [C_SSM, C_LRR, C_TCM, C_SURPLUS][:len(names)]
    exp = scs[0]['calibration']['exp_ref']
    fig, axs = _plt().subplots(1, 2, figsize=(14, 8), sharey=True)
    for ax, hs, ttl in zip(axs, (nom, non), ('With the CORP levy (nominal base)', 'Without the levy (individual WDT alone)')):
        for i, h in enumerate(hs):
            blocks = [h['by_country'].get(iso, {}).get('cov_ref') or {} for iso in order] + [h['overall']['cov_ref']]
            med = np.array([_nan(b.get('p50')) for b in blocks])
            lo = np.array([_nan(b.get('p10')) for b in blocks])
            hi = np.array([_nan(b.get('p90')) for b in blocks])
            ax.errorbar(med, y + off[i], xerr=[med - lo, hi - med], fmt='o', ms=4, color=cols[i], ecolor=cols[i],
                        elinewidth=1, capsize=0, label=labs[i])
        ax.axhline(len(order) - 0.5, color=C_ANNOTATION, lw=0.6)
        ax.set_yticks(y, rows)
        ax.set_xlabel(f'Relief / reference expenditure ({exp:.0%} of GDP): median, bars p10-p90')
        ax.set_title(ttl)
        _pct(ax, 'x', 0)
    axs[0].legend(loc='lower right')
    fig.suptitle('Share of reference expenditure covered by relief, by country')
    return save_fig(fig, _path(13, 'cover_by_country'))


def f14_lever_stack(data, p):
    """Cumulative lever stack: spending covered at each step with the levy off, on a real base and on the nominal base (median, bars p10-p90)."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    names = fg['stack']
    scs = [_scen(data, n) for n in names]
    cases = [('none', 'No levy (individual WDT)', C_ANNOTATION), ('real', 'Real-basis levy', C_LRR), ('nominal', 'Nominal-basis levy', C_SSM)]
    n = len(names)
    x = np.arange(n)
    w = 0.27
    fig, ax = _plt().subplots(figsize=FIG_WIDE)
    nom_med = None
    for k, (case, lab, col) in enumerate(cases):
        ds = [wc.levy_headline(s, mode, case)['overall']['cov_ref'] for s in scs]
        med = np.array([_nan(d['p50']) for d in ds])
        lo = np.array([_nan(d['p10']) for d in ds])
        hi = np.array([_nan(d['p90']) for d in ds])
        ax.bar(x + (k - 1) * w, med, w, color=col, label=lab, yerr=[med - lo, hi - med], ecolor=C_DARK, capsize=2, error_kw={'lw': 0.8})
        if case == 'nominal':
            nom_med, nom_hi = med, hi
    for i in range(1, n):
        ax.text(x[i] + w, nom_hi[i], f'{(nom_med[i] - nom_med[i - 1]) * 100:+.1f} pp', ha='center', va='bottom', fontsize=8)
    ax.set_xticks(x, [_wrap(s['label'], 20) for s in scs], fontsize=8)
    ax.set_ylabel('Relief / reference expenditure (median, bars p10-p90)')
    ax.set_title(f'What each lever adds to the share of spending covered, index {mode}')
    ax.legend(loc='upper left')
    _pct(ax, 'y', 0)
    return save_fig(fig, _path(14, 'lever_stack'))


def f15_frontier(data, p):
    """Spending covered against realised burden, every design. Point numbers are the rows of Table 15."""
    apply_style()
    fg = p['rates']['figures']
    mode, grp = fg['mode'], fg['group']
    names = fg['frontier']
    stack = set(fg['stack'])
    scs = [_scen(data, n) for n in names]
    m = [_med(s, mode) for s in scs]
    ma = [wc.scenario_medians(s, mode, all_windows=True) for s in scs]
    yv = np.array([_nan(v.get('cov_ref')) for v in m])
    fig, axs = _plt().subplots(1, 2, figsize=FIG_PAIR)
    for ax, key, dec in zip(axs, ('stock', 'gain'), (1, 0)):
        xv = np.array([_nan(v.get(f'er_{key}_{grp}')) for v in ma])
        for i, nme in enumerate(names):
            ax.scatter(xv[i], yv[i], color=C_TCM if nme in stack else C_SSM, zorder=3)
            ax.annotate(str(i + 1), (xv[i], yv[i]), xytext=(4, 3), textcoords='offset points', fontsize=7)
        ax.set_xlabel(f'Realised {key} rate, {grp} group (median)')
        _pct(ax, 'x', dec)
        _pct(ax, 'y', 0)
    axs[0].set_ylabel('Relief / reference expenditure (median)')
    axs[0].scatter([], [], color=C_TCM, label='In the lever stack')
    axs[0].scatter([], [], color=C_SSM, label='Other designs')
    axs[0].legend()
    fig.suptitle(f'Spending covered against burden, index {mode}')
    return save_fig(fig, _path(15, 'frontier'))


def f16_revenue_by_tier(data, p):
    """Share of adults, of wealth and of net receipts by launch-wealth band."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    bands = sc['calibration'].get('bands')
    if not bands:
        raise SystemExit(f"scenario '{sc['label']}' has no wealth bands in rates_data.json; re-run rates_core.py")
    a = wc.scenario_medians(sc, mode, all_windows=True)
    labels = band_labels(bands['edges_gbp_m'])
    n = len(labels)
    x = np.arange(n)
    w = 0.27
    fig, ax = _plt().subplots(figsize=FIG_WIDE)
    ax.bar(x - w, bands['adult_share'], w, color=C_SSM, label='Adults')
    ax.bar(x, bands['wealth_share'], w, color=C_SURPLUS, label='Wealth')
    ax.bar(x + w, [_nan(a.get(f'revshare_band{i}')) for i in range(n)], w, color=C_TCM, label='Net WDT receipts')
    ax.axhline(0, color=C_ANNOTATION, lw=0.8)
    ax.set_xticks(x, [_wrap(lab, 14) for lab in labels], fontsize=7)
    ax.set_xlabel('Launch wealth band')
    ax.set_title(_title(sc, mode, 'Who holds the base and who pays'))
    ax.legend()
    _pct(ax, 'y', 0)
    return save_fig(fig, _path(16, 'revenue_by_tier'))


def f17_tax_replacement(data, p):
    """Median relief split into the taxes it retires and what is left for the tax-free threshold."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    scs = [_scen(data, n) for n in fg['stack']]
    left = np.array([_nan(wc.levy_headline(s, mode, case)['overall']['relief_gdp']['p50']) for s in scs])
    bottom = np.zeros(len(scs))
    x = np.arange(len(scs))
    fig, ax = _plt().subplots(figsize=FIG_WIDE)
    for (lab, v), col in zip(rp['retire'], [C_SSM, C_SURPLUS, C_BASELINE]):
        part = np.minimum(left, v)
        left = left - part
        ax.bar(x, part, bottom=bottom, color=col, label=f'Replaces {lab.lower()}')
        bottom += part
    left = np.maximum(left, 0.0)
    s_e = rp['employer_share'] if rp['employer_legs'] else 0.0
    ax.bar(x, left * (1.0 - s_e), bottom=bottom, color=C_LRR, label='Left for the common tax-free threshold')
    if s_e > 0.0:
        ax.bar(x, left * s_e, bottom=bottom + left * (1.0 - s_e), color=C_TCM, label='Left for the employer NI threshold')
    ax.axhline(sum(v for _, v in rp['retire']), color=C_DARK, lw=1.0, ls='--', label='CGT + IHT + corporation tax')
    ax.set_xticks(x, [_wrap(s['label'], 20) for s in scs], fontsize=8)
    ax.set_ylabel('Relief, share of GDP (median)')
    ax.set_title(f'What the relief replaces, index {mode}, {_CASE_TXT[case]}')
    ax.legend(loc='upper left')
    _pct(ax, 'y', 0)
    return save_fig(fig, _path(17, 'tax_replacement'))


def f18_threshold_by_country(data, p):
    """Tax-free threshold reachable by country: one marker per headline scenario (median, bars p10-p90)."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    names, labs = fg['headline'], fg['headline_names']
    scs = [_scen(data, n) for n in names]
    hs = [wc.levy_headline(s, mode, case) for s in scs]
    order = sorted(hs[0]['by_country'], key=lambda i: _nan(hs[0]['by_country'][i]['relief_gdp']['p50']))
    rows = order + ['All']
    y = np.arange(len(rows))
    off = np.linspace(-0.27, 0.27, len(names))
    cols = [C_SSM, C_LRR, C_TCM, C_SURPLUS][:len(names)]
    pa0 = wc.threshold_outcomes(0.0, rp)['allowance']
    hrt = rp['legs']['income_tax']['extra'][0][0] if rp['legs']['income_tax']['extra'] else None
    fig, ax = _plt().subplots(figsize=(10, 8))
    for i, h in enumerate(hs):
        blocks = [h['by_country'].get(iso, {}).get('relief_gdp') or {} for iso in order] + [h['overall']['relief_gdp']]
        vals = {q: np.array([wc.threshold_outcomes(b[q], rp)['x'] if b.get(q) is not None else np.nan for b in blocks])
                for q in ('p10', 'p50', 'p90')}
        ax.errorbar(vals['p50'], y + off[i], xerr=[vals['p50'] - vals['p10'], vals['p90'] - vals['p50']],
                    fmt='o', ms=4, color=cols[i], ecolor=cols[i], elinewidth=1, capsize=0, label=labs[i])
    ax.axvline(pa0, color=C_DARK, lw=1.0, ls='--', label=f'Today\'s allowance: £{pa0:,.0f}')
    if hrt:
        ax.axvline(hrt, color=C_ANNOTATION, lw=0.8, ls=':', label=f'Higher-rate threshold today: £{hrt:,.0f}')
    ax.axhline(len(order) - 0.5, color=C_ANNOTATION, lw=0.6)
    ax.set_yticks(y, rows)
    ax.set_xlabel(thr_head(rp) + ', £ a year (median, bars p10-p90)')
    ax.xaxis.set_major_formatter(lambda v, _: f'£{v:,.0f}')
    ax.legend(loc='lower right', fontsize=7)
    ax.set_title('How high each country\'s relief could set the tax-free threshold, on a UK-shaped tax bill\n'
                 f'CGT, IHT and corporation tax retired first, {_CASE_TXT[case]}; a marker at today\'s allowance means no room', fontsize=10)
    return save_fig(fig, _path(18, 'threshold_by_country'))


def f19_threshold_by_schedule(data, p):
    """Tax-free threshold under each WDT rate schedule (left) and the tax a person saves by income at the median threshold (right)."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    scs = [_scen(data, n) for n in fg['thresholds']]
    pa0 = wc.threshold_outcomes(0.0, rp)['allowance']
    hrt = rp['legs']['income_tax']['extra'][0][0] if rp['legs']['income_tax']['extra'] else None
    ys = np.arange(len(scs))[::-1]
    income = np.linspace(0, 150000, 301)
    fig, (a1, a2) = _plt().subplots(1, 2, figsize=(14, 6.5))
    cmap = _plt().get_cmap('tab10')
    for i, sc in enumerate(scs):
        rd = wc.levy_headline(sc, mode, case)['overall']['relief_gdp']
        if rd.get('p50') is None:
            continue
        x = {q: wc.threshold_outcomes(rd[q], rp)['x'] if rd.get(q) is not None else np.nan for q in ('p10', 'p50', 'p90')}
        a1.errorbar(x['p50'], ys[i], xerr=[[x['p50'] - x['p10']], [x['p90'] - x['p50']]], fmt='o', ms=5, color=cmap(i % 10),
                    ecolor=cmap(i % 10), elinewidth=1.2, capsize=2)
        a2.plot(income, [wc.person_saving(v, x['p50'], rp) for v in income], color=cmap(i % 10), lw=1.3, label=_wrap(sc['label'], 38))
    a1.axvline(pa0, color=C_DARK, lw=1.0, ls='--', label=f'Today\'s allowance £{pa0:,.0f}')
    a1.set_yticks(ys, [_wrap(s['label'], 30) for s in scs], fontsize=7)
    a1.set_xlabel(thr_head(rp) + ', £ a year (median, bars p10-p90)')
    a1.xaxis.set_major_formatter(lambda v, _: f'£{v:,.0f}')
    a1.set_title('The tax-free threshold each schedule funds')
    a1.legend(loc='lower right', fontsize=7)
    if hrt:
        a2.axvline(hrt, color=C_ANNOTATION, lw=0.8, ls=':', label=f'Higher-rate threshold today £{hrt:,.0f}')
    a2.set_xlabel('Income, £ a year')
    a2.set_ylabel('Income tax and employee NI saved, £ a year (median threshold)')
    a2.xaxis.set_major_formatter(lambda v, _: f'£{v / 1000:.0f}k')
    a2.yaxis.set_major_formatter(lambda v, _: f'£{v:,.0f}')
    a2.set_title('What a person saves, by income: nobody who pays today loses')
    a2.legend(fontsize=6, loc='upper left')
    fig.suptitle(f'Tax-free threshold by WDT rate schedule, {_CASE_TXT[case]}', fontsize=11)
    return save_fig(fig, _path(19, 'threshold_by_schedule'))

def f20_consumption(data, p):
    """Spending covered (left) and realised burden, payers beside the top group, for each consumption assumption."""
    apply_style()
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    scs = [_scen(data, n) for n in fg['consumption']]
    m = [_med(s, mode) for s in scs]
    ma = [wc.scenario_medians(s, mode, all_windows=True) for s in scs]
    x = np.arange(len(scs))
    fig, (a1, a2, a3) = _plt().subplots(1, 3, figsize=FIG_TRIPLE)
    cols = [C_BASELINE] + [C_LRR] * (len(scs) - 1)                  # reference scenario in red
    a1.bar(x, [_nan(v.get('cov_ref')) for v in m], color=cols)
    a1.set_title('Spending covered (relief / reference expenditure)')
    _pct(a1, 'y', 0)
    _burden_panels(a2, a3, ma, x, grp, top)
    for ax in (a1, a2, a3):
        ax.set_xticks(x, [_wrap(s['label'], 16) for s in scs], fontsize=6)
    fig.suptitle(f'Sensitivity to consumption, index {mode}; the first bar is the reference')
    return save_fig(fig, _path(20, 'consumption'))

def f21_threshold_beneficiaries(data, p):
    """The labour tax relief base: people (left), how much each saves (middle), total saving with p10-p90 (right)."""
    apply_style()
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    scs = [_scen(data, n) for n in fg['thresholds']]
    ed = rp['saving_bands_gbp']
    labs = [f'< £{ed[0]:,.0f}'] + [f'£{a:,.0f} to £{b:,.0f}' for a, b in zip(ed[:-1], ed[1:])] + [f'≥ £{ed[-1]:,.0f}']
    cmap = _plt().get_cmap('viridis', len(labs))
    ys = np.arange(len(scs))[::-1]
    shown = set()

    def lab(key, text):
        """Legend text the first time a key is drawn, None after (no duplicate entries)."""
        if key in shown:
            return None
        shown.add(key)
        return text

    fig, (a1, a2, a3) = _plt().subplots(1, 3, figsize=FIG_TRIPLE, sharey=True)
    for i, sc in enumerate(scs):
        scope = sc['calibration']['scope']['adult_share'] * rp['adults_m']
        a1.scatter(scope, ys[i], marker='D', color=C_TCM, zorder=3, label=lab('scope', 'Adults in WDT scope at launch'))
        rd = wc.levy_headline(sc, mode, case)['overall']['relief_gdp']
        if rd.get('p50') is None:
            continue
        b = {q: wc.threshold_beneficiaries(wc.threshold_outcomes(rd[q], rp)['x'], rp)
             for q in ('p10', 'p50', 'p90') if rd.get(q) is not None}
        m = b['p50']
        a1.scatter(m['beneficiaries_m'], ys[i], color=C_SSM, zorder=3, label=lab('ben', 'Beneficiaries (income-tax payers today)'))
        a1.scatter(m['exempt_m'], ys[i], marker='s', color=C_LRR, zorder=3, label=lab('ex', 'Newly tax-free'))
        left = 0.0
        for j, v in enumerate(m['band_m']):
            a2.barh(ys[i], v, left=left, color=cmap(j), label=lab(f'band{j}', labs[j]))
            left += v
        lo, hi = (b[q]['total_gbp_bn'] if q in b else np.nan for q in ('p10', 'p90'))
        a3.errorbar(m['total_gbp_bn'], ys[i], xerr=[[m['total_gbp_bn'] - lo], [hi - m['total_gbp_bn']]], fmt='o', ms=5,
                    color=C_SURPLUS, ecolor=C_SURPLUS, elinewidth=1.2, capsize=2)
    a1.set_yticks(ys, [_wrap(s['label'], 30) for s in scs], fontsize=7)
    a1.set_xlabel('Millions of people (median threshold)')
    a1.set_title('Who gains')
    a1.legend(loc='lower right', fontsize=7)
    a2.set_xlabel('Beneficiaries, millions, by annual saving')
    a2.set_title('How much each saves a year')
    a2.legend(title='Saving', fontsize=7, loc='lower right')
    a3.set_xlabel('Income tax and employee NI saved, £bn a year (median, bars p10 to p90)')
    a3.set_title('Total saving')
    fig.suptitle(f'The labour tax relief base, {_CASE_TXT[case]}', fontsize=11)
    return save_fig(fig, _path(21, 'threshold_beneficiaries'))

def f22_net_position(data, p):
    """Net position by wealth band while relief is paid: per adult (left), the WDT burden as a stock rate (middle), who is better off (right)."""
    apply_style()
    sc, mode, h = _ctx(data, p)
    rp = p['rates']['replacement']
    npn = wc.band_net_position(sc, mode, rp)
    if npn is None:
        raise SystemExit(f"scenario '{sc['label']}' has no median relief; cannot build the net position by band")
    labels = [_wrap(l, 9) for l in band_labels(sc['calibration']['bands']['edges_gbp_m'])]
    bands = npn['bands']
    x = np.arange(len(bands))
    w = 0.38
    rep = np.array([_nan(r['repeal']) for r in bands])
    fig, (a1, a2, a3) = _plt().subplots(1, 3, figsize=FIG_TRIPLE)
    a1.bar(x - w / 2, [_nan(r['wdt']) for r in bands], w, color=C_BASELINE, label='WDT paid')
    a1.bar(x + w / 2, [r['saving'] for r in bands] + rep, w, color=C_LRR, label='Gain (threshold saving, income profile, + repeal)')
    a1.scatter(x + w / 2, npn['avg_saving'] + rep, marker='_', s=300, color=C_DARK, zorder=3, label='Gain bounds: average adult')
    a1.scatter(x + w / 2, npn['max_saving'] + rep, marker='_', s=300, color=C_ANNOTATION, zorder=3, label='Gain bounds: largest saver')
    a1.set_yscale('symlog', linthresh=1000)
    a1.set_xticks(x, labels, fontsize=6)
    a1.set_ylabel('£ per adult a year (symlog)')
    a1.set_title('What each band pays and what it gains')
    a1.yaxis.set_major_formatter(lambda v, _: f'£{v:,.0f}')
    a1.legend(fontsize=7, loc='upper left')
    a2.bar(x, [_nan(r['stock_rate']) for r in bands], color=C_SSM)
    a2.set_xticks(x, labels, fontsize=6)
    a2.set_ylabel('WDT / band wealth, a year (post-fill horizon)')
    a2.set_title('The same payment as a stock rate')
    _pct(a2, 'y', 1)
    adults = np.array([r['adults_m'] * 1e3 for r in bands])
    cols = [C_ANNOTATION if r['net'] is None else (C_LRR if r['net'] >= 0 else C_BASELINE) for r in bands]
    a3.bar(x, adults, color=cols)
    a3.set_yscale('log')
    a3.set_xticks(x, labels, fontsize=6)
    a3.set_ylabel('Adults in the band, thousands (log)')
    a3.set_title('Who is better off, income-profile reading\n(green better off, red worse off)')
    a3.yaxis.set_major_formatter(lambda v, _: f'{v:,.0f}')
    fig.suptitle(_title(sc, mode, f'Net position by wealth band, {sc["cfg"]["horizon"]} years after fund fill'))
    return save_fig(fig, _path(22, 'net_position'))

# (number, slug, function): the numbers and slugs must match TABLES in 8_2_RATES_tables.py
FIGURES = [
    (1, 'relief_by_country', f1_relief_by_country),
    (2, 'coverage_denominators', f2_coverage_denominators),
    (3, 'revenue_components', f3_revenue_components),
    (4, 'rate_grid', f4_rate_grid),
    (5, 'drift', f5_drift),
    (6, 'by_era', f6_by_era),
    (7, 'rate_curve', f7_rate_curve),
    (8, 'closure', f8_closure),
    (9, 'schedule_grid', f9_schedule_grid),
    (10, 'cohorts', f10_cohorts),
    (11, 'schedule_curves', f11_schedule_curves),
    (12, 'scope', f12_scope),
    (13, 'cover_by_country', f13_cover_by_country),
    (14, 'lever_stack', f14_lever_stack),
    (15, 'frontier', f15_frontier),
    (16, 'revenue_by_tier', f16_revenue_by_tier),
    (17, 'tax_replacement', f17_tax_replacement),
    (18, 'threshold_by_country', f18_threshold_by_country),
    (19, 'threshold_by_schedule', f19_threshold_by_schedule),
    (20, 'consumption', f20_consumption),
    (21, 'threshold_beneficiaries', f21_threshold_beneficiaries),
    (22, 'net_position', f22_net_position)
]


def main():
    import matplotlib
    matplotlib.use('Agg')
    p = wc.load_rates_params()
    data = wc.load_json(out_dir(CODE) / 'rates_data.json')
    for n, slug, fn in FIGURES:
        fn(data, p)
    print(f'Written {len(FIGURES)} figures to {out_dir(CODE) / "charts"}')


if __name__ == '__main__':
    main()
