# WDT Rates and Revenue — Parameters File
# =========================================
# This file is the single source of truth for all model inputs.
# The Excel workbook (7_1_260726_Rates_Analysis.xlsx) is now treated as a
# frozen checker only; Python reads nothing from it at runtime except for
# validation comparisons.
#
# TOML type rules relied on here:
#   integers  : no quotes, no decimal point   (e.g. 1947)
#   floats    : no quotes, must have decimal  (e.g. 0.001)
#   strings   : double-quoted
#   arrays    : [[double-bracket section headers]] for array-of-tables
#
# N CONVENTION (read this before touching any N value)
# ----------------------------------------------------
# There are two different "N"s in this project and they must not be confused:
#   N_val  = [val] N_demo = 30 : the taxpayer holding period. Canonical for every
#            individual-level VAL / VAL.A / VAL.B table and figure.
#   N_fill = SSM LRR fill year : a FUND-MECHANICS output derived at load time by
#            load_params() (currently 19 for the 2000 start). Used by RATES.
# wdt_core.load_params() exposes both: p['N_val'] and p['N_fill'] (p['N'] is kept
# as an alias of N_fill for RATES code). run_sim / run_sim_hist /
# decompose_tw_advantage / npv_tax_advantage REQUIRE N to be passed explicitly.


# ─────────────────────────────────────────────────────────────
# [meta] — run identity
# ─────────────────────────────────────────────────────────────
[meta]
version        = "v7"
date           = "2026-09-08"
scenario_label = "2000 Balanced"   # human-readable label for outputs
excel_checker  = "7.1_260725_Rates_Analysis.xlsx"   # frozen; for validation only

[output]
generate_charts = true

# ─────────────────────────────────────────────────────────────
# [rate] — WDT logistic rate function parameters
#
# tau(W) = tau_m / (1 + ((tau_m - tau_0) / tau_0) * exp(-k * (W - W_min)))
#        = 0  if W < W_min
#
# tau_0  : floor rate at W = W_min (fraction, e.g. 0.15 = 15%)
# tau_m  : asymptotic ceiling rate (fraction, e.g. 0.70 = 70%)
# k      : steepness parameter (per £m); controls how fast rates rise
# W_min  : wealth level at which the rate function begins to apply (£m)
#           — a rate design parameter, not a population boundary
# ─────────────────────────────────────────────────────────────
# [rate] RETIRED (D2, apply_basis_d2_rho.py). The rate design is [rates.defaults] (the gain ladder, W_min = 1 x median house price);
# a named variant is a [rates.scenarios.*]. wdt_core.load_params fills p['tau_0'], p['tau_m'], p['k'], p['W_min'] from those defaults
# for the legacy SSM only. The former baseline (logistic 30% / 90% / k 0.005, every adult in scope) is [rates.scenarios.logistic_ref].


# ─────────────────────────────────────────────────────────────
# [swf] — Sovereign Wealth Fund sizing parameters
#
# srr_ratio  : SRR target = srr_ratio × (cumulative net income / N)
#              Working value 3×; recommended Governing Council floor 3×
# lrr_years  : LRR floor expressed as N years of prevailing government
#              expenditure; recommended minimum 3 years
# ─────────────────────────────────────────────────────────────
[swf]
srr_ratio = 3.0   # SRR capitalisation ratio (× average net annual income)
lrr_years = 3.0   # LRR floor (years of government expenditure)


# ─────────────────────────────────────────────────────────────
# [budget] — UK government expenditure model
#
# budget_base   : OBR total managed expenditure base year (£b)
#                 Source: OBR 2022–23 outturn = £1,157.4b
# budget_growth : nominal expenditure growth rate per annum (fraction)
#                 Source: UK historical public expenditure 1999–2019 = 4.51%
# ─────────────────────────────────────────────────────────────
[budget]
budget_base   = 1157.4   # £b (2022–23 OBR total managed expenditure)
budget_growth = 0.0451   # 4.51% p.a. nominal growth


# ─────────────────────────────────────────────────────────────
# [returns] — UK equity return series
#
# series_base_year : the calendar year corresponding to index 0 of the
#                    returns array below; all other years are offsets from it.
#                    The sweep rotates this series to test all start years.
# values           : 73 annual total-return figures (fraction, e.g. 0.1045)
#                    Source: UK equity capital total return data 1947–2019
#                    Order: 1947, 1948, … 2019  (index 0 = 1947)
# ─────────────────────────────────────────────────────────────
[returns]
series_base_year = 1947

# Annual returns 1947–2019 inclusive (73 values).
# These are the same values used in the Excel model UK Fiscal Growth sheet,
# re-ordered to canonical calendar order (1947 first).
# IMPORTANT: if the Excel sheet's WDT Year 0 differs from 1947, update
# series_base_year above and reorder accordingly.
values = [
  0.0168,   # 1947
 -0.0050,   # 1948
