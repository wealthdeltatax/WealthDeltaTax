# ─────────────────────────────────────────────────────────────
# [rates] — RATES rebuild (rates_core.py)
#
# Everything the RATES core, tables and charts need. Parsed by
# wdt_core._parse_rates; read as p['rates'].
#
# CONVENTIONS
#   * TOML has no null. An OPTIONAL setting that is "off" is simply omitted:
#     tiers, wmin_pct, payout_top, exp_paths, levy, countries.
#   * Money is £m unless a key says £bn. Rates and shares are fractions.
#   * [rates.defaults] is the baseline config. Each [rates.scenarios.NAME]
#     changes ONLY the keys it names; a misspelt key raises at load time.
#   * The rebuild does not use N_fill / the old SSM: the fund fills dynamically
#     inside each window (rates_core, fund layer).
# ─────────────────────────────────────────────────────────────
[rates]
jst_path         = "jst_r6.json"   # JST Macrohistory file; looked up in the RATES folder, then in Model/
uk_iso           = "GBR"           # country used to calibrate the wealth distribution
calibration_year = 2017            # year of UK population / GDP used with the wealth data
exp_ref_year     = 2019            # year whose UK expenditure/GDP is the fixed cov_ref denominator
valgen_dir       = "../VAL"        # folder holding valgen_core.py, relative to the RATES folder (rates_test.py only)

# ── Baseline config (was DEFAULT_CFG in rates_sweep.py) ───────
[rates.defaults]
basis            = "real"                          # "real" (CPI-deflated, conservative) | "nominal"
index_modes      = ["gdp_pc"]     # threshold indexation: cpi | gdp_pc | wealth | house | none ("house" = JST house-price index; used by wmin_house_hp)
c                = 0.035        # consumption share of net worth per year (valgen D16); used when c_mode = "fixed"
c_mode           = "fixed"      # "fixed" = c everywhere | "stationary" = per-window c keeping an untaxed holder's wealth/GDP flat
c_bounds         = [0.0, 0.10]  # clip range for the stationary c
diag_tops        = [0.01, 0.001]   # top fractions reported in the concentration diagnostics
dist             = "advani"     # wealth distribution: "advani" (evidence-based) | "adjusted" | "survey"
dist_mode        = "central"    # advani: central | upper;  adjusted: add | reallocate;  survey: add
pop_per_adult    = 1.27         # population / adult population (UK)
wmin_gbp_m       = 0.0          # W_min in £m (0 = every adult is in scope); ignored if wmin_pct is set
k_per_gbp_m      = 0.005        # rate steepness per £m (rescaled to GDP-per-capita units internally)
tau_0            = 0.30         # floor rate at W_min
tau_m            = 0.90         # ceiling rate
T                = 100           # window length, years (needs fill + horizon)
exp_ref          = "uk_2019"    # fixed reference expenditure/GDP for cov_ref: "uk_2019" or a number (fraction)
heir_rule        = "delta"      # "delta" (mechanism as designed, valgen D6) | "fresh" (ablation only)
n_phase          = 6            # death-phase lines per bracket/tier
G                = 30           # generation gap, years
ms               = 3.0          # SRR target, multiples of A_t
ml               = 3.0          # LRR target, multiples of A_t (reaction-time buffer)
a_window         = 5            # years in the trailing mean A_t
horizon          = 10           # years after LRR fill over which coverage is measured
safe_share       = 0.0          # share of the fund held in the safe asset
exclude_flagged  = false        # drop windows containing flagged suspect years
payout_top_frac  = 0.01         # which cells payout_top applies to: top q of adults (scenarios that need another value set it)
payout_constrained = true       # others' consumption adjusts so the wealth-weighted mean payout stays c
start_stride     = 1            # take every k-th start year (speed; 1 = all)
# S2 (Work Order Wave 1 S2): routes and verification. The defaults below reproduce the earlier engine (all in kind; Route B only via route_b_mode).
route_mix        = "none"       # "none" | "wealth" (archetype mixture interpolated by launch wealth) | "blend" (route_mix_weights, same in every cell) | an [archetypes.*] name
route_mix_weights = {}          # for route_mix = "blend": archetype -> weight, summing to 1
lam_C            = "toml"       # Route C verification hazard: "toml" = [verification].lambda_C, or a number
lam_D            = "toml"       # Route D corrective-auction hazard: "toml" = [verification].lambda_D, or a number (acts only if the rule set's dauc is on)
death_verify     = "toml"       # "toml" = [verification].death_verifies | "on" | "off"
# optional (omitted = off):
#   tiers      = [[0.1, -0.0455], [0.3, -0.0205], [0.4, 0.0095], [0.2, 0.0345]]   # [weight, return differential]
#   wmin_pct   = 0.05                       # set W_min at the wealth of the top 5% of adults at launch
#   payout_top = 0.005                      # consumption share of the top cells
#   exp_paths  = { flat = "gdp", grow2 = 0.02 }   # expenditure paths; "gdp" = tracks GDP
#   countries  = ["GBR", "USA"]
#   cohorts    = "central"                  # a name in [rates.cohorts.*]: return heterogeneity
#   wmin_house_ratio = 1.0                  # W_min = ratio x median house price at launch (overrides wmin_gbp_m)
#   anchor_from = "stock_ladder"            # fit k of a logistic to that ladder's top anchor
# D2 patch (apply_basis_d2_rho.py): the gain ladder is the baseline everywhere (D2). Logistics are comparison schedules only.
schedule         = "gain_ladder"   # "logistic" | "logistic_ln" | a name in [rates.schedules.*]
wmin_house_ratio = 1.0             # W_min = ratio x median house price at launch (0.0 = off: every adult in scope, or wmin_gbp_m / wmin_pct)
rule_set         = "candidate"  # "base" | "candidate" | an explicit key c_cap/verify_down/dauc: see [rules]. RATES honest lines feel the c_cap part (the value cap)
k_ln             = 1.0          # steepness for logistic_ln (dimensionless, per unit of ln(W / W_min))
zucman_floor     = 0.02         # annual stock-rate floor tested on the billionaire cells (a CHECK, not a target)
zucman_threshold_gbp_m = 1000.0 # cells with launch mean wealth at or above this form the billionaire pool
dist_kw          = { body_split = 5, body_split_from = 0.5 }   # overrides for the distribution builder (a scenario that sets dist_kw REPLACES this); body split lets W_min fall inside a decile
# CORP corporate levy, ON by default. Two tiers (CORP 5.1 table):
#   unattributed owners (tranche three, unattributed foreign):        tau  = 0.70 final, on share f_inc of market cap
#   attributed owners who do not reconcile individually (identified foreign beneficial owners, institutions failing the attribution test):
#                                                                      tau0 = tau_0 final, on share f_attr of market cap
#   Attributed NATIVE holders and intermediaries that pass the test are credited against their own WDT: no net levy, already in the engine.
#   Base: NOMINAL market-cap delta (JST eq_capgain, nominal, whatever `basis` is); positive years only (CORP 5.5: no levy, no refund in loss years).
#   Share of GDP = mc_gdp * max(0, nominal equity price return) / (1 + nominal GDP growth) * (tau * f_inc + tau0 * f_attr).
#   tau0   = 0.0375: INPUT ONLY WHILE levy_calibrate = false; otherwise solved (see [rates.levy_calibration]). It was the ladders' first anchor (stock ladder 0.0015 / (0.05 - 0.01)); the logistic_ln scenarios use 4%. One value for
#            every scenario, so it does not follow a scenario's own tau_0 (the legacy baseline's 30% is not used).
#   f_attr + f_inc = 0.588: overseas beneficial owners of UK-listed equity, ONS "Ownership of UK quoted shares: 2024" (29 Jan 2026; 57.7% in 2022,
#            56.3% in 2020). Foreign holders are outside the household distribution, so no double count. UK DC pensions, insurers and funds are
#            not charged. UK institutions failing the attribution test (tau0 final, at most 29.6% of value) are left out: at most +0.4 pp of the levy base.
#   f_inc  = 0.10: share of UK-listed equity that is UNATTRIBUTED. NOT OBSERVED: it is a Phase One outcome of the attribution regime, and ONS gives
#            beneficial owners only by look-through. PLACEHOLDER, SWEEP 0.02 to 0.20.
#   mc_gdp = 0.876: £2.54tn UK-domiciled LSE-listed market cap (ONS, end 2024) / UK nominal GDP 2024 of about £2.90tn (ICAEW / ONS). Both are end-2024 / calendar-2024, so the ratio is
#            year-matched. It is NOT divided by [rates.replacement].gdp_gbp_bn (2025): that would mix a 2024 stock with a 2025 flow. Earlier value 0.89 used a derived GDP of £2.85tn (World Bank USD at 1.28), now superseded. VERIFY the market cap against the latest ONS release.
# A scenario switches it off with every key set to zero (see levy_off). Windows need nominal eq_capgain and GDP.
levy             = { tau = 0.70, f_inc = 0.10, tau0 = 0.0375, f_attr = 0.488, mc_gdp = 0.876 }
levy_basis       = "nominal"    # "nominal" (the statutory base) | "real" (CPI-deflated price return and GDP growth). Sets the headline levy columns;
                                # the JSON always carries all three cases (nominal | real | none) under headline.*.levy_variants.
levy_cal_base    = ""           # "" = solve the levy on [rates.levy_calibration].base | "nominal" | "real": the base THIS scenario solves on
levy_calibrate   = true         # solve the levy's entry rate so its median receipts equal [rates.levy_calibration].target (see that section)

# ── CORP levy calibration ─────────────────────────────────────
# The levy replaces corporation tax, so its entry rate is not a free parameter: it is set so that the MEDIAN levy receipts over all
# valid windows (every country, every start year, the NOMINAL base: the statutory one) equal the revenue the levy retires.
#   target = name of an entry in [rates.replacement].retire; its share of GDP is the target ("Corporation tax" = 3.2%)
#   solve  = "tau0"  : solve tau0 (attributed owners), keep tau on the unattributed tier. Closed form, no solver. If the unattributed tier
#                      ALONE already exceeds the target, tau0 would be negative: it is floored at 0, a warning is printed and the JSON records
#                      infeasible = true. Then lower f_inc or tau.
#            "scale" : multiply tau and tau0 by one factor, keeping their ratio.
# Calibrated ONCE on the nominal base and then applied unchanged to the real-basis variant, so the real variant shows what is lost if the
# base is deflated: it is the conservative case, not a second calibration.
[rates.levy_calibration]
target = "Corporation tax"
solve  = "tau0"
base   = "nominal"   # median base the entry rate is solved on: "nominal" (statute) | "real" (deflated). "real" makes the real-basis variant match the target; the nominal variant then overshoots

# ── Suspect-year flags (diagnostics, not exclusions) ──────────
[rates.flags]
real_return_lo = -0.40    # real capital_tr below this is flagged
real_return_hi =  0.60    # real capital_tr above this is flagged
infl_hi        =  0.50    # CPI inflation above this is flagged

# ── Eras used to group start years ────────────────────────────
[[rates.eras]]
name = "pre-1914"
lo = 0
hi = 1913
[[rates.eras]]
name = "1914-45"
lo = 1914
hi = 1945
[[rates.eras]]
name = "1946-79"
lo = 1946
hi = 1979
[[rates.eras]]
name = "1980+"
lo = 1980
hi = 3000

# ── Wealth distribution constants (rates_dist) ────────────────
[rates.dist]
ons_total_bn     = 14600.0    # £bn, GB household net wealth 2016-18 (ONS WAS)
rich_list_bn     = 772.8      # £bn, Sunday Times Rich List 2025, top 350
rich_list_n      = 350        # people in that list
table_total_bn   = 42945.4    # £bn, total of the old household bracket table (survey anchors are shares of it)
survey_anchor_q  = [0.10, 0.05, 0.01, 0.001, 0.0001, 0.00001]            # top fractions
survey_anchor_bn = [19658.2, 14021.2, 6109.3, 1665.6, 429.1, 96.6]       # £bn held by each top fraction (old table)
body_deciles_bn  = [24.0, 159.7, 474.1, 1017.4, 1806.9, 2780.4, 3941.2, 5412.4, 7671.1]   # £bn, deciles 0-10 .. 80-90
edges_90_99      = [0.10, 0.08, 0.06, 0.04, 0.02, 0.01]                  # cell edges, 90th-99th percentile (top fractions)
edges_top1       = [0.01, 0.005, 0.002, 0.001, 0.0005, 0.0002, 0.0001, 0.00003, 0.00001]   # cell edges inside the top 1%
tier_alpha       = 1.5        # Pareto alpha splitting the named Rich List tier (stylised, not sourced)
adjusted_s1      = 0.225      # 'adjusted': top-1% share (estate-based, one fifth to one quarter)
adjusted_s01     = 0.09       # 'adjusted': top-0.1% share (WID-style)
adjusted_entry_gbp_m = 350.0  # 'adjusted': Rich List entry wealth, £m
adjusted_tier_cuts = [10, 100]   # 'adjusted': rank cuts splitting the 350 into three cells (top 10, 11-100, 101-350)
house_median_gbp_m = 0.225    # PLACEHOLDER: UK median house price in calibration_year (2017), £m. VERIFY against ONS HPSSA.

[rates.dist.advani]            # Advani, Bangham & Leslie (2021), WTC Evidence Paper 1; GB 2016-18
survey_total_bn   = 14400.0    # £bn, WAS on their definition
s10_survey        = 0.51       # top-10% share, survey
s1_survey         = 0.18       # top-1% share, survey
s1_upper          = 0.23       # top-1% share after Rich List + Pareto adjustment ('upper' variant)
extra_central_frac = 0.05      # 'central': total wealth this share higher than the survey
strl_n            = 1000       # Rich List entries (2017/18 editions)
strl_bn           = 700.0      # £bn, their total value
strl_entry_m      = 100.0      # £m, list entry (~£103m, 2016 list)
tier_cuts         = [0.01, 0.1, 1.0]   # named tier split into three cells at these fractions of its members

# ── Return heterogeneity (Fagereng, Guiso, Malacrino & Pistaferri 2020, Econometrica) ──
# tiers   = persistent return differentials [weight, additive pp as fraction], applied in EVERY cell
# premium = [top fraction of adults, extra return LEVEL for cells inside it]; narrowest band wins
# Both are demeaned by launch-wealth weights in rates_core: the wealth-weighted mean return stays
# at the JST r. Cohorts redistribute return between holders; they add none.
[rates.cohorts.central]
label   = "Cohorts, central (tier SD 2.5pp, top-1% premium +1.4pp)"
tiers   = [[0.10, -0.0455], [0.30, -0.0205], [0.40, 0.0095], [0.20, 0.0345]]
premium = [[0.01, 0.014]]

[rates.cohorts.high]
label   = "Cohorts, high (tier SD 4.9pp, graded top premium; EXTRAPOLATION)"
tiers   = [[0.10, -0.0910], [0.30, -0.0410], [0.40, 0.0190], [0.20, 0.0690]]
premium = [[0.05, 0.010], [0.01, 0.028], [0.001, 0.040], [0.0001, 0.050]]   # PLACEHOLDER levels: no source above the top 1%

# ── Rate ladders ──
# Anchors are [W £m at launch, TARGET effective rate]; interpolated linearly in ln W, flat beyond the ends.
# basis: "stock" (annual rate on wealth) | "gain" (rate on the return, income-tax equivalent) | "delta" (statutory, no conversion).
# r_ref, c_ref convert the target for an accumulator earning r_ref and consuming c_ref to the statutory rate on the delta:
#   stock: tau = s / (r_ref - c_ref);  gain: tau = G r_ref / (r_ref - c_ref).
# Gain anchors = average UK income-tax rate at gain = r W (PA £12,570; 20% to £50,270; 40% to £125,140; 45% above;
# no allowance taper; from memory, VERIFY). The first anchor of each ladder (at W_min) is a design choice, to avoid a cliff at entry.
[rates.schedules.gain_ladder]
label   = "Income-tax-equivalent gain ladder (top 45%)"
basis   = "gain"
r_ref   = 0.05
c_ref   = 0.01
anchors = [[0.225, 0.03], [0.5, 0.10], [1.0, 0.15], [2.5, 0.30], [5.0, 0.375], [25.0, 0.435], [100.0, 0.45]]

[rates.schedules.stock_ladder]
label   = "Stock-rate ladder (0.5% at £0.5m, 1% from £2.5m, 2% at £1bn)"
basis   = "stock"
r_ref   = 0.05
c_ref   = 0.01
anchors = [[0.225, 0.0015], [0.5, 0.005], [2.5, 0.01], [1000.0, 0.02]]

# ── Optional extras (expenditure paths) ───────────────────────
[rates.extras]
windows         = [[20, 30], [40, 50]]   # [from, to] year windows reported when exp_paths is set
trailing_window = 5                      # years in the trailing coverage used for breakeven

# ── Run options ───────────────────────────────────────────────
[rates.run]
quantiles       = [0.10, 0.50, 0.90]     # reported for every headline distribution
drift_band      = [0.67, 1.5]            # wealth/GDP end ÷ launch: "stable base" windows lie inside this band
rate_curve_W    = [0.1, 0.5, 1.0, 2.0, 5.0, 10.0, 20.0, 50.0, 100.0, 200.0, 500.0, 1000.0]   # £m, tau(W) tabulated in the JSON
float_digits    = 10                     # significant digits kept in the JSON
revenue_bands_gbp_m = [0.25, 0.5, 1.0, 2.5, 5.0, 25.0, 100.0, 1000.0]   # £m, ascending; cell launch mean wealth is cut at these edges for the revenue-by-tier output
scenarios = [
  "baseline", "levy_off",
  # rate grid read by figure/table 4
  "tau0_015_k_002", "tau0_010_k_003", "tau0_010_k_005",
  "logistic_ref", "wmin_all",
  # wealth distribution: the weakest input, so all variants stay
  "dist_advani_upper", "dist_adjusted_add", "dist_adjusted_reallocate", "dist_survey",
  # mechanism-critical ablation and scale
  "heir_fresh", "wealth_x13",
  # consumption: aggregate (stationary, 2%, 5%) and top-cell payout
  "stationary_c", "c_002", "c_005",
  "top6_at_3", "top6_at_2", "top6_at_1", "top6_at_05",
  "top1_at_05", "top1_at_1", "top1_at_2",
  # data-quality check, cheap
  "exclude_flagged",
  # hybrid design: cohorts, W_min at the median house price, ladders, anchor-fitted logistics
  "cohort_central", "cohort_high", "wmin_house", "wmin_house_hp",
  "gain_ladder", "stock_ladder", "logistic_ln_ref",
  "logistic_ln_gain", "logistic_ln_stock", "logistic_gain", "logistic_stock",
  # lever stack: schedule, then cohorts, then the upper wealth distribution
  "stock_ladder_cohort", "gain_ladder_cohort", "gain_ladder_cohort_upper",
  # ceiling: the lever stack plus top-cell consumption at the c_ref the ladders were calibrated on
  "gain_ladder_cohort_upper_c1",
  # consumption sensitivity on the headline ladder (T20 / F20)
  "gl_c_001", "gl_c_002", "gl_c_005", "gl_stationary", "gl_top6_1", "gl_top6_1_free",
  # levy calibration base and f_inc (T25 / F25)
  "gl_levy_cal_nominal", "gl_levy_cal_real", "gl_levy_stat_f002", "gl_levy_stat_f005",
  "gl_levy_stat_f010", "gl_levy_stat_f015", "gl_levy_stat_f020",
  # rule-set ablation: the headline ladder under the BASE rule set (units cap only)
  "gain_ladder_rule_base",
  # Route B lien / income (T100 patch)
  "gl_rb_sale",
  "gl_rb_lien",
  "gl_rb_lien_sp0",
  "gl_rb_lien_sp3",
  "gl_rb_lien_sp6",
  "gl_rb_lien_sp12",
  "gl_rb_income",
  "gl_rb_income_cap75",
  "gl_rb_income_cap50",
  # route mixture and archetype sweep (S2)
  "gl_arch_wealth", "gl_arch_housing_pension", "gl_arch_startup_founder", "gl_arch_generational", "gl_arch_ceo_fintech",
  "gl_arch_resource_monopoly", "gl_arch_blend", "gl_arch_wealth_lien", "gl_arch_wealth_income",
  "gl_arch_wealth_lam005", "gl_arch_wealth_lam005_dv",
]
# Parked (defined below, not run; for the SWEEPS_R rebuild): tau0_010, tau0_020, taum_050, taum_090, k_0005, k_002,
# wmin_1m, wmin_5m, wmin_top5, wmin_top2, ms_*, ml_*, a_window_*, safe_share_*, horizon_5, T40_*, top2_at_05,
# payout_top_1, payout_top_7, c_0005.
quick = [                               # python rates_core.py --quick (figure scenarios are added automatically)
  "baseline", "dist_advani_upper", "dist_survey", "heir_fresh",
  "stationary_c", "c_002", "top6_at_1", "cohort_central",
]

# ── Tax replacement (T17 / T18 / T19, F17 / F18 / F19) ──
# Relief (share of GDP, at the quantile named in `cases`) retires the taxes in `retire`, IN THIS ORDER. What is left is SPLIT in two:
#   * (1 - employer_share) funds ONE common tax-free threshold X for the `unify` legs (income tax, employee NI): below X a person pays neither;
#   * employer_share funds a SEPARATE tax-free threshold X_e for the `employer_legs` (employer NI): below X_e the employer pays none.
# Above its threshold each leg charges its own rate on the excess, so liability grows from zero at X (X_e). Two thresholds, because employer NI
# starts far lower today (£5,000 against £12,570) and one common X would have to be solved across both. Every taxpayer is counted, WDT payers
# included: the thresholds are universal and nobody who pays today is worse off. Closes against today's revenue (the 1.8 pp gap between
# reference expenditure and revenue is left open).
# ALL NUMBERS BELOW ARE PLACEHOLDERS FROM MEMORY EXCEPT gdp_gbp_bn (sourced, see its comment): VERIFY (HMRC / OBR / ONS).
#   gdp_gbp_bn       UK GDP, £bn
#   cases            relief quantiles read by T17-T19 ("p50", "p10", "p90")
#   levy_case        which levy variant the tax-replacement tables read: "real" (conservative: deflated base, same rate) | "nominal" | "none"
#   retire           [name, share of GDP] retired in this order
#   unify            legs that share the common threshold X (each leg's threshold becomes max(own, X))
#   employer_legs    legs paid by the employer that get their OWN threshold X_e (each leg's threshold becomes max(own, X_e)); disjoint from unify.
#                    Empty list = no employer leg: the whole leftover funds X and employer_share is ignored (forced to 0)
#   employer_share   share of the leftover relief that funds X_e, 0 <= share < 1. JUDGMENT, NOT SOURCED: 0.25 is a placeholder, a little under the
#                    leg's share of the combined IT + NI cost at one common X (about 39%). 0 = leave employer NI as it is. SWEEP 0 to 0.40
#   person_legs      legs a PERSON pays (income tax, employee NI): used for "tax saved at income £Y". Employer NI is the employer's.
#   phase_in_gbp     0 = liability starts at X at the full rate. > 0 = the marginal rate rises linearly from 0 at X to the full rate at X + this,
#                    so tax switches on gradually. Costs MORE per £ of X (people just above X save more), so the X the same relief buys is
#                    lower; the benefit is spread further up the income range. Applies to each leg's base rate, not the higher-rate band.
#   x_cap_gbp        the solver stops here; a threshold reported as "> cap" is a solver limit, not an economic one
#   calibrate_counts scale each leg's taxpayer-count curve so the leg raises its own share_gdp today (placeholders agree with each other)
#   example_incomes  £ a year at which T19 / F19 report the tax a person saves
#   share_gdp = what the leg raises today, share of GDP (income tax + NI sum to 16.2%)
#   threshold = today's threshold (£ a year);  rate = rate charged above it
#   extra     = [[income £, extra rate above it]]: the higher-rate band moves up by the same £ as the threshold
#   n_above   = [[income £, millions of people with income above it]], interpolated
[rates.replacement]
gdp_gbp_bn       = 3040.0   # UK nominal GDP 2025, £bn (ICAEW / ONS; the earlier 2850 was derived from World Bank USD at an average rate). GDP largely cancels in the thresholds X and X_e (calibrated_legs scales counts by share_gdp x GDP); it moves the £bn and per-adult figures in T22 / T22b. VERIFY against the latest ONS blue book.
cases            = ["p50", "p10", "p90"]
levy_case        = "nominal"
retire           = [["Capital gains tax", 0.0050], ["Inheritance tax", 0.0030], ["Corporation tax", 0.0320]]
unify            = ["income_tax", "ni_employee"]
employer_legs    = ["ni_employer"]
employer_share   = 0.25
person_legs      = ["income_tax", "ni_employee"]
phase_in_gbp     = 0.0
x_cap_gbp        = 100000.0
calibrate_counts = true
example_incomes  = [15000.0, 20000.0, 30000.0, 50000.0, 100000.0]
adults_m         = 54.0     # PLACEHOLDER: UK adults, millions (ONS; VERIFY). Only used to turn the WDT scope adult share into millions
motivated_gbp    = 1000.0   # a beneficiary counts as "motivated" if they save at least this a year (judgment, not sourced)
saving_bands_gbp = [250.0, 500.0, 1000.0, 2000.0, 5000.0]   # F21 splits beneficiaries by annual saving at these edges

[rates.replacement.legs.income_tax]
share_gdp = 0.100
threshold = 12570.0
rate      = 0.20
extra     = [[50270.0, 0.20]]
n_above   = [[5000.0, 40.0], [12570.0, 36.0], [20000.0, 28.0], [30000.0, 19.0], [40000.0, 12.0],
             [50270.0, 8.0], [70000.0, 4.0], [100000.0, 2.0], [125140.0, 1.0], [250000.0, 0.3], [500000.0, 0.0]]

[rates.replacement.legs.ni_employee]
share_gdp = 0.021
threshold = 12570.0
rate      = 0.08
n_above   = [[5000.0, 31.0], [12570.0, 29.0], [20000.0, 23.0], [30000.0, 15.0], [40000.0, 9.0],
             [50270.0, 6.0], [70000.0, 3.0], [100000.0, 1.5], [125140.0, 0.8], [500000.0, 0.0]]

[rates.replacement.legs.ni_employer]
share_gdp = 0.041
threshold = 5000.0
rate      = 0.15
n_above   = [[5000.0, 31.0], [12570.0, 29.0], [20000.0, 23.0], [30000.0, 15.0], [40000.0, 9.0],
             [50270.0, 6.0], [70000.0, 3.0], [100000.0, 1.5], [125140.0, 0.8], [500000.0, 0.0]]

# T22 / F22 income profile. One row per launch-wealth band of [rates.run].revenue_bands_gbp_m (ascending: one more row than there are edges).
#   incomes  = five taxable incomes (£ a year) at the 10th / 30th / 50th / 70th / 90th percentile of the band's adults, equal weight; 0 = no income
#   ni_share = share of the band's adults who pay employee NI (earners; the rest are retired or live on capital income)
# Only the SHAPE matters: band_net_position rescales the profile so the adults' total saving equals what the threshold solver says the relief buys.
# The profile decides who gets the saving, not how much there is. Above about £57k every income saves the same maximum.
# ALL NUMBERS ARE PLACEHOLDERS (judgment, not sourced). REPLACE with a joint income-by-wealth cut of ONS WAS (or HMRC) before quoting.
[rates.replacement.income_by_wealth]
incomes = [
  [0.0,     9000.0,   20000.0,  30000.0,  45000.0],      # < £0.25m
  [6000.0,  15000.0,  26000.0,  38000.0,  60000.0],      # £0.25m to £0.5m
  [9000.0,  20000.0,  33000.0,  48000.0,  80000.0],      # £0.5m to £1m
  [10000.0, 25000.0,  42000.0,  65000.0,  110000.0],     # £1m to £2.5m
  [12000.0, 32000.0,  55000.0,  90000.0,  160000.0],     # £2.5m to £5m
  [15000.0, 45000.0,  85000.0,  150000.0, 400000.0],     # £5m to £25m
  [20000.0, 60000.0,  120000.0, 300000.0, 1000000.0],    # £25m to £100m
  [30000.0, 100000.0, 250000.0, 600000.0, 2000000.0],    # £100m to £1000m
  [50000.0, 150000.0, 400000.0, 1000000.0, 5000000.0],   # >= £1000m
]
ni_share = [0.60, 0.50, 0.45, 0.40, 0.35, 0.30, 0.25, 0.20, 0.20]

# ── Closure test (does the tax replace what it is meant to replace?) ──
[rates.closure]
replaced_tax_gdp = "uk_2019"   # revenue/GDP being replaced: "uk_2019" = JST UK revenue/GDP in exp_ref_year, or a number (fraction)

# ── Which scenarios the figures and tables read ───────────────
[rates.figures]
scenario     = "gain_ladder"   # main scenario for the single-scenario tables/figures (1, 2, 5-8, 16): the conservative hybrid design
mode         = "gdp_pc"
group     = "payers"    # wealth-weighted burden on every net-paying cell
top_group = "top0.1"    # second burden group shown beside it in T4/F4 and T9/F9
decomposition = ["baseline", "levy_off", "heir_fresh", "dist_advani_upper", "wealth_x13", "top6_at_05"]
rate_grid    = ["logistic_ref", "tau0_015_k_002", "tau0_010_k_003", "tau0_010_k_005"]   # F4: tau_0 x k combinations
schedules    = ["gain_ladder", "stock_ladder", "logistic_ln_gain", "logistic_ln_stock", "logistic_gain", "logistic_stock"]   # F9, F11
cohorts      = ["baseline", "cohort_central", "cohort_high", "stock_ladder", "stock_ladder_cohort", "gain_ladder", "gain_ladder_cohort"]   # F10
scope        = ["wmin_all", "baseline", "wmin_house_hp"]     # F12
# Cumulative lever stack (F14): each entry changes one thing from the one before.
#   stock ladder -> gain ladder (rate schedule) -> + central cohorts -> + Advani upper distribution
stack        = ["stock_ladder", "gain_ladder", "gain_ladder_cohort", "gain_ladder_cohort_upper", "gain_ladder_cohort_upper_c1"]
# Headline by country (F13): one scenario per name. Every lever here is sourced; cohort_high (placeholder premium)
# and wealth_x13 (a sensitivity) are deliberately outside it. F15 plots stack + schedules + cohorts (derived).
headline     = ["stock_ladder", "gain_ladder", "gain_ladder_cohort_upper", "gain_ladder_cohort_upper_c1"]
headline_names = ["Conservative", "Central", "Optimistic", "Ceiling"]
# T20/F20: consumption sensitivity on the headline ladder. First entry is the reference (c = 3.5%).
consumption  = ["gain_ladder", "gl_c_001", "gl_c_002", "gl_c_005", "gl_stationary", "gl_top6_1", "gl_top6_1_free"]
# T25 / F25: levy calibration base and f_inc, on the main scenario's schedule (the main scenario is added in front)
levy         = ["gl_levy_cal_nominal", "gl_levy_cal_real", "gl_levy_stat_f002", "gl_levy_stat_f005", "gl_levy_stat_f010", "gl_levy_stat_f015", "gl_levy_stat_f020"]
# T22b / F22b (not written yet): Route B sale, lien (spread sweep), income (cap sweep)
route_b      = ["gl_rb_sale", "gl_rb_lien", "gl_rb_lien_sp0", "gl_rb_lien_sp3", "gl_rb_lien_sp6", "gl_rb_lien_sp12", "gl_rb_income", "gl_rb_income_cap75", "gl_rb_income_cap50"]

