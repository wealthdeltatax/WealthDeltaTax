payout_top_frac = 0.06
dist_kw = { body_split = 5, body_split_from = 0.5 }


# ═════════════════════════════════════════════════════════════════════════════
# Representativeness of the history (T23-T25 / F23-F25)
# ═════════════════════════════════════════════════════════════════════════════
# Is the replayed history the UK of today? Three tools: slices of the windows by regime (T23), a block bootstrap that says how many
# independent windows there really are (T24), and the levy's dependence on its calibration base and on f_inc (T25).
#   low_growth_max    geometric-mean REAL GDP/head growth a year below which a window is "low growth". JUDGMENT: the UK has run at roughly
#                     0.5% since 2008, against about 2% for the post-war windows. VERIFY against ONS.
#   low_infl_max      mean CPI inflation a year below which a window is "low inflation" (matters for the nominal levy base). JUDGMENT.
#   focus_countries   ISO codes shown as their own slice beside the pooled panel (the UK itself, and the closest stagnation analogue)
#   exp_today         total managed expenditure / GDP today, shown beside the fixed JST 2019 reference. SOURCED: OBR Economic and fiscal outlook,
#                     March 2026, forecast for 2025-26: spending £1,368bn = 44.8% of GDP. A forecast, not an outturn: update when the ONS
#                     outturn is published. The earlier 0.44 was a placeholder from JUR's 2022-23 TME (£1,157b) over a GDP of about £2.65tn.
#   rev_today         public sector current receipts / GDP today, for the closure test (base multiple). SOURCED: OBR March 2026, 2025-26:
#                     receipts £1,235bn = 40.4% of GDP. The earlier 0.37 was a placeholder and implied a deficit of about £232bn against a
#                     published 2024-25 deficit of about £150bn (ONS provisional: receipts £1,134bn, PSNB £152bn). Same OBR forecast gives
#                     a 2025-26 deficit of £133bn (4.3% of GDP): 44.8% less 40.4% is the 4.4 pp gap, rounding aside.
#   today_label       the year and source of exp_today and rev_today, quoted in the T23 caption (a string; keep it in step with the two values)
#   n_boot            bootstrap resamples per metric and scheme
#   boot_seed         RNG seed
#   block_years       block length for the bootstrap, in start years. 30 = the window length: blocks of that size are close to non-overlapping
#   boot_ci           lower and upper quantile of the bootstrap interval
#   bootstrap_scenarios  scenarios that carry the bootstrap in the JSON (each adds a few seconds)
[rates.representativeness]
low_growth_max      = 0.01
low_infl_max        = 0.04
focus_countries     = ["GBR", "JPN"]
exp_today           = 0.448
rev_today           = 0.404
today_label         = "OBR March 2026 forecast for 2025-26"
n_boot              = 500
boot_seed           = 20261008
block_years         = 100   # = T (D7)
boot_ci             = [0.05, 0.95]
bootstrap_scenarios = ["stock_ladder", "gain_ladder", "gain_ladder_cohort_upper", "gain_ladder_cohort_upper_c1"]

# ── Levy sensitivity (T25 / F25) on the main scenario's schedule ──────────────────────────────────────────────
# Calibrated: tau0 is solved so the levy's median receipts equal the retired corporation tax; only the BASE it is solved on differs.
# Statutory: levy_calibrate = false, so tau0 stays at its input and what the levy raises is an OUTPUT. f_inc is varied and
# f_attr = 0.588 - f_inc (overseas beneficial ownership of UK-listed equity, ONS), so the total share charged stays fixed.
[rates.scenarios.gl_levy_cal_nominal]
label = "Gain ladder, levy calibrated on the nominal base"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_cal_base = "nominal"
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_cal_real]
label = "Gain ladder, levy calibrated on the real base"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_cal_base = "real"
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_stat_f002]
label = "Gain ladder, statutory levy, f_inc 2%"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_calibrate = false
levy = { tau = 0.70, f_inc = 0.02, tau0 = 0.0375, f_attr = 0.568, mc_gdp = 0.876 }
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_stat_f005]
label = "Gain ladder, statutory levy, f_inc 5%"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_calibrate = false
levy = { tau = 0.70, f_inc = 0.05, tau0 = 0.0375, f_attr = 0.538, mc_gdp = 0.876 }
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_stat_f010]
label = "Gain ladder, statutory levy, f_inc 10%"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_calibrate = false
levy = { tau = 0.70, f_inc = 0.10, tau0 = 0.0375, f_attr = 0.488, mc_gdp = 0.876 }
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_stat_f015]
label = "Gain ladder, statutory levy, f_inc 15%"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_calibrate = false
levy = { tau = 0.70, f_inc = 0.15, tau0 = 0.0375, f_attr = 0.438, mc_gdp = 0.876 }
dist_kw = { body_split = 5, body_split_from = 0.5 }

[rates.scenarios.gl_levy_stat_f020]
label = "Gain ladder, statutory levy, f_inc 20%"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
levy_calibrate = false
levy = { tau = 0.70, f_inc = 0.20, tau0 = 0.0375, f_attr = 0.388, mc_gdp = 0.876 }
dist_kw = { body_split = 5, body_split_from = 0.5 }

# ─────────────────────────────────────────────────────────────
# [rules] — the two rule sets, named once for RATES and VAL
# A rule set is the key 'c_cap/verify_down/dauc' (see valgen_core, RULE SETS); wdt_core.parse_rule reads it.
#   base      the rule before the gaming fixes: Route C refund capped by units paid only
#   candidate the simple universal candidate: units and value cap, a verify-down is a basis reset, corrective auction on C and D
# [rates.defaults] rule_set = "base" | "candidate" | an explicit key. RATES honest lines feel only the c_cap part (verify_down and the
# auction act when alpha != 1); VAL searches all of it.
# ─────────────────────────────────────────────────────────────
[rules]
base      = "units/allow/off"
candidate = "units_and_value/reset/on"

[rates.scenarios.gain_ladder_rule_base]
label = "Gain ladder under the BASE rule set (units cap only): the value cap's effect"
rule_set = "base"
wmin_house_ratio = 1.0
schedule = "gain_ladder"
dist_kw = { body_split = 5, body_split_from = 0.5 }


# ═════════════════════════════════════════════════════════════════════════════
# Phase 1 item 3 additions (WDT_Refactor_Plan.md). All values are PLACEHOLDERS to research (plan section 8, risk 7).
# payment_mode = "sale" keeps the old behaviour everywhere; set "lien" or "income" to run the D4b scenarios.
# ═════════════════════════════════════════════════════════════════════════════

[route_b]
payment_mode        = "sale"      # sale (old: cash-equivalent units) | lien (deferred balance, settled at death) | income (paid from external income)
sovereign_real_rate = 0.015       # lien accrues at sovereign real rate + deferral_spread (D4c)
deferral_spread     = 0.01        # the breakeven spread is solved in valgen_core (plan section 6)
# RATES: Route B share of a line's holdings by launch wealth (£m); linear in ln W between points, flat beyond. From the section 4 archetypes.
share_by_wealth     = [[0.4, 0.65], [8.0, 0.10], [30.0, 0.10], [50.0, 0.25], [500.0, 0.05]]

[income]
cap             = 1.0             # share of external income that can go to WDT (sweep 0.5, 0.75, 1.0)
cap_sweep       = [0.5, 0.75, 1.0]
default_ratio   = 0.0             # external income / wealth when no archetype is named
# RATES: external income / wealth by launch wealth (£m), same interpolation as share_by_wealth (section 4.1)
ratio_by_wealth = [[0.4, 0.08], [8.0, 0.02], [30.0, 0.05], [50.0, 0.005], [500.0, 0.01]]

[income.by_archetype]
housing_pension   = 0.08
startup_founder   = 0.02
generational      = 0.005
ceo_fintech       = 0.05
resource_monopoly = 0.01

[verification]
lambda_C       = 0.0              # per-year verification hazard, Route C (D6)
lambda_D       = 0.0              # per-year corrective-auction hazard, Route D. In VAL, 0 = couple to lambda_C (valgen _lam_D); > 0 = used as given
death_verifies = false            # true: death verifies Route C with certainty (D6); Route D is always auctioned at death
lambda_sweep   = [0.0, 0.02, 0.05, 0.10]

[archetypes.housing_pension]
label = "Housing and pension"
V0_m  = 0.4
A = 0.30
B = 0.65
C = 0.02
D = 0.03

[archetypes.startup_founder]
label = "Start-up founder"
V0_m  = 8.0
A = 0.10
B = 0.10
C = 0.70
D = 0.10

[archetypes.generational]
label = "Generational wealth"
V0_m  = 50.0
A = 0.50
B = 0.25
C = 0.08
D = 0.17

[archetypes.ceo_fintech]
label = "CEO / fintech"
V0_m  = 30.0
A = 0.40
B = 0.10
C = 0.40
D = 0.10

[archetypes.resource_monopoly]
label = "Resource monopoly"
V0_m  = 500.0
A = 0.10
B = 0.05
C = 0.20
D = 0.65

