"""
8_2_RATES_tables.py — RATES tables (one per figure)
====================================================
Reads OUTPUTS/RATES/rates_data.json and writes one markdown table per figure to
OUTPUTS/RATES/tables/rates_table_{n}_{slug}.md. Table n is the data behind figure n in
8_3_RATES_charts.py: same number, same slug.

Pure formatting: no simulation, no import of rates_core. Which scenario and index mode
each table reads is set in WDT_Params.toml [rates.figures]. Add a table by writing one
function and registering it in TABLES; add the matching figure in 8_3_RATES_charts.py
(rates_test.py checks the two registries agree).

Tables 1-8 read the main scenario (and the decomposition / rate-grid lists).
Tables 9-12 present the hybrid design:
  9  schedule_grid    ladders and anchor-fitted logistics: revenue, burden, residual traditional tax
  10 cohorts          homogeneous base against the two cohort variants
  11 schedule_curves  the rate schedules side by side
  12 scope            who is above W_min at launch
Tables 13-16 present the headline:
  13 cover_by_country share of reference expenditure covered, by country, with and without the CORP levy
  14 lever_stack      the cumulative stack: what each lever adds, with the levy off, on a real base, and on the nominal base
  15 frontier         spending covered against realised burden, every design
  16 revenue_by_tier  where the revenue comes from, by launch-wealth band
  17 tax_replacement  relief retires CGT, IHT, corporation tax; the rest funds a common tax-free threshold (income tax, employee NI) and an employer-NI threshold
  18 threshold_by_country  the tax-free thresholds each country's relief could reach, by headline scenario
  19 threshold_by_schedule  the tax-free thresholds under each WDT rate schedule, and what a person saves at example incomes

Spending covered = relief paid after fund fill / fixed reference expenditure. Relief and coverage are medians over
windows in which the fund fills; receipts, burden, drift and tier shares are medians over all windows.

    python 8_2_RATES_tables.py
"""

import sys
from pathlib import Path

# wdt_* modules and WDT_Params.toml live in Model/, one level above this RATES folder
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import wdt_core as wc
from wdt_fmt import band_labels, ensure_dir, fmt_f, fmt_f2, fmt_pct, fmt_pct0, fmt_pct1, out_dir, group_label, legs_label, thr_head
from wdt_md import LEFT, RIGHT, MdDoc

CODE = 'RATES'


# ── helpers ──────────────────────────────────────────────────────────────────

def _scen(data, name):
    """Scenario block, with a clear message if it has not been run."""
    try:
        return data['scenarios'][name]
    except KeyError:
        raise SystemExit(f"scenario '{name}' is not in rates_data.json; run: "
                         f"python rates_core.py --scenario {name}")


def _ctx(data, p, name=None):
    """(scenario block, mode, headline block, cfg) for the figures' main scenario."""
    fg = p['rates']['figures']
    sc = _scen(data, name or fg['scenario'])
    mode = fg['mode']
    return sc, mode, sc['headline'][mode], sc['cfg']


def _med(sc, mode):
    """Medians block for a scenario. Uses `mode` if the scenario ran it, else the one mode it did run
    (e.g. the house-index scenario), and returns the mode used."""
    hl = sc['headline']
    m = mode if mode in hl else next(iter(hl))
    return hl[m]['overall']['medians'], m


def _x(m, key, f=fmt_pct):
    """Format medians[key], or a dash when it is missing / null."""
    v = m.get(key)
    return '—' if v is None else f(v)


def _rate_txt(c):
    s = c.get('schedule', 'logistic')
    if s == 'logistic':
        return (f"tau_0 = {fmt_pct0(c['tau_0'])}, tau_m = {fmt_pct0(c['tau_m'])}, "
                f"k = {c['k_per_gbp_m']:g} per £m")
    if s == 'logistic_ln':
        return f"logistic in ln W, tau_0 = {fmt_pct0(c['tau_0'])}, tau_m = {fmt_pct0(c['tau_m'])}"
    return f"schedule = {s}"


def _desc(sc, mode):
    """Parameter caption fragment drawn from the scenario's own config."""
    c = sc['cfg']
    coh = f", cohorts = {c['cohorts']}" if c.get('cohorts') else ''
    return (f"{sc['label']}; {_rate_txt(c)}, W_min = £{sc['calibration']['wmin_gbp_m']:g}m, "
            f"T = {c['T']}, horizon = {c['horizon']}, index = {mode}, c = {fmt_pct1(c['c'])} "
            f"({c['c_mode']}), heir rule = {c['heir_rule']}{coh}")


def _band(d, f=fmt_pct):
    """'p10 / p50 / p90' from a dist_stats block."""
    return f"{f(d['p10'])} / {f(d['p50'])} / {f(d['p90'])}"


def _levy_note(sc):
    """Caption sentence on how the levy was calibrated, from the scenario's own JSON block."""
    lc = sc['calibration'].get('levy_cal')
    if not lc:
        return 'The CORP levy is not calibrated in this scenario.'
    s = (f"The CORP levy is calibrated so its median receipts on the nominal base equal {lc['target'].lower()} "
         f"({fmt_pct1(lc['target_gdp'])} of GDP): tau0 = {fmt_pct1(lc['tau0'])}, tau = {fmt_pct0(lc['tau'])}; the same rates on a real base "
         f"raise a median {fmt_pct1(lc['achieved_real_gdp'])}.")
    if lc['infeasible']:
        s += (f" The calibration is INFEASIBLE: the unattributed tier alone raises {fmt_pct1(lc['unattributed_tier_gdp'])}, above the target, "
              f"so tau0 is floored at 0 and the levy overshoots.")
    return s


def _thr(o, rp, emp=False):
    """A threshold_outcomes result as table text: the common threshold X, or the employer threshold X_e with emp=True."""
    sfx = '_emp' if emp else ''
    st = o['status' + sfx]
    if st == 'none':
        return '—'
    if st == 'below':
        return f"< £{o['allowance' + sfx]:,.0f}"
    if st == 'cap':
        return f"> £{rp['x_cap_gbp']:,.0f}"
    return f"£{o['x' + sfx]:,.0f}"


_CASE_TXT = {'real': 'a real-basis levy', 'nominal': 'the nominal-basis levy', 'none': 'no levy'}


# ── tables 1-8 ───────────────────────────────────────────────────────────────

def t1_relief_by_country(data, p):
    sc, mode, h, _ = _ctx(data, p)
    rows = []
    for iso, b in sorted(h['by_country'].items(), key=lambda kv: -(kv[1]['relief_gdp']['p50'] or 0)):
        rows.append([f'**{iso}**', b['windows'], b['uncensored'], _band(b['relief_gdp']),
                     fmt_pct1(b['fail_share'])])
    ov = h['overall']
    rows.append(['**All**', ov['windows'], ov['uncensored'], _band(ov['relief_gdp']),
                 fmt_pct1(ov['fail_share'])])
    d = MdDoc()
    d.table(['Country', 'Windows', 'Uncensored', 'Relief / GDP (p10 / median / p90)', 'Fail share'],
            rows, col_fmt=[LEFT, RIGHT, RIGHT, RIGHT, RIGHT])
    d.caption(f'Table 1: Relief paid over the horizon after fund fill, as a share of GDP, by country. {_desc(sc, mode)}.')
    return d


def t2_coverage_denominators(data, p):
    sc, mode, h, _ = _ctx(data, p)
    ref = sc['calibration']['exp_ref']
    rows = []
    for iso, b in sorted(h['by_country'].items(), key=lambda kv: -(kv[1]['coverage']['p50'] or 0)):
        rows.append([f'**{iso}**', fmt_pct1(b['relief_gdp']['p50']), fmt_pct1(b['exp_gdp_mean']),
                     fmt_pct1(b['coverage']['p50']), fmt_pct1(b['cov_ref']['p50'])])
    ov = h['overall']
    rows.append(['**All (country median)**', fmt_pct1(ov['relief_gdp']['p50']),
                 fmt_pct1(ov['exp_gdp_mean']), fmt_pct1(ov['country_median_coverage']),
                 fmt_pct1(ov['country_median_cov_ref'])])
    d = MdDoc()
    d.table(['Country', 'Relief / GDP', 'Own expenditure / GDP', 'Coverage (own)', 'Coverage (reference)'],
            rows, col_fmt=[LEFT, RIGHT, RIGHT, RIGHT, RIGHT])
    d.caption(f'Table 2: Median coverage of expenditure against each country\'s own spending and against the fixed '
              f'reference ratio ({fmt_pct1(ref)} of GDP). Own-country coverage is inflated where historical '
              f'governments were small. {_desc(sc, mode)}.')
    return d


def t3_revenue_components(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    rows = []
    for name in fg['decomposition']:
        sc = _scen(data, name)
        m = sc['headline'][mode]['overall']['medians']                    # fund fills: relief
        a = wc.scenario_medians(sc, mode, all_windows=True)               # all windows: receipts, drift
        rows.append([f"**{sc['label']}**", fmt_pct(a['tax_gdp_mean']), fmt_pct(a['heir_gdp_mean']),
                     fmt_pct(a['levy_gdp_mean']), fmt_pct(a['refund_gdp_mean']), fmt_pct(a['net_gdp_mean']),
                     fmt_pct(m['relief_gdp']), fmt_f2(a['drift'])])
    d = MdDoc()
    d.table(['Scenario', 'Holding-year tax', 'Heir receipts', 'Corporate levy (unattributed)', 'Refunds', 'Net receipts',
             'Relief paid', 'Drift'], rows, col_fmt=[LEFT] + [RIGHT] * 7)
    d.caption(f'Table 3: Median annual receipts as a share of GDP by component, index = {mode}. Components are '
              f'medians over all windows (relief: windows in which the fund fills), so they need not sum to the net median. '
              f'The corporate levy is the CORP final charge on unattributed listed ownership, on nominal market-cap gains; '
              f'it is paid by companies, so it is in net receipts and relief but not in the individual burden rates. '
              f'Drift is wealth/GDP at window end '
              f'over launch.')
    return d


def t4_rate_grid(data, p):
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    rows = []
    for name in fg['rate_grid']:
        sc = _scen(data, name)
        c, m = sc['cfg'], sc['headline'][mode]['overall']['medians']
        a = wc.scenario_medians(sc, mode, all_windows=True)
        rows.append([f"**{sc['label']}**", fmt_pct0(c['tau_0']), f"{c['k_per_gbp_m']:g}",
                     fmt_pct(m['relief_gdp']),
                     _x(a, f'er_stock_{grp}'), _x(a, f'er_stock_{top}'),
                     _x(a, f'er_gain_{grp}', fmt_pct1), _x(a, f'er_gain_{top}', fmt_pct1),
                     fmt_f2(a['drift'])])
    gl, tl = group_label(grp), group_label(top)
    d = MdDoc()
    d.table(['Scenario', 'tau_0', 'k per £m', 'Relief / GDP', f'Stock rate ({gl})', f'Stock rate ({tl})',
             f'Gain rate ({gl})', f'Gain rate ({tl})', 'Drift'],
            rows, col_fmt=[LEFT] + [RIGHT] * 8)
    d.caption(f'Table 4: Revenue against burden for tau_0 and k combinations, index = {mode}. Stock rate is net WDT '
              f'over wealth per year; gain rate is net WDT over accrued return. Each is a ratio of sums, so it is '
              f'wealth-weighted: the {gl} columns pool every net-paying cell, the {tl} columns only the top '
              f'{tl.removeprefix("top ")} of adults. Both include heir receipts.')
    return d


def t5_drift(data, p):
    sc, mode, h, _ = _ctx(data, p)
    lo, hi = p['rates']['run']['drift_band']
    rows = []
    for iso, b in sorted(h['by_country'].items()):
        st = b['stable']
        rows.append([f'**{iso}**', _band(b['drift'], fmt_f2), st['windows'], b['windows'],
                     fmt_pct(st['relief_gdp_median'])])
    ov = h['overall']
    rows.append(['**All**', _band(ov['drift'], fmt_f2), ov['stable']['windows'], ov['windows'],
                 fmt_pct(ov['stable']['relief_gdp_median'])])
    d = MdDoc()
    d.table(['Country', 'Drift (p10 / median / p90)', 'Stable windows', 'Windows', 'Relief / GDP, stable only'],
            rows, col_fmt=[LEFT, RIGHT, RIGHT, RIGHT, RIGHT])
    d.caption(f'Table 5: Tax-base drift (wealth/GDP at window end over launch). Stable windows lie in '
              f'[{fmt_f2(lo)}, {fmt_f2(hi)}]. {_desc(sc, mode)}.')
    return d


def t6_by_era(data, p):
    sc, mode, h, _ = _ctx(data, p)
    rows = []
    for era, b in h['by_era'].items():
        rows.append([f'**{era}**', b['windows'], fmt_pct1(b['censored_share']), fmt_pct1(b['fail_share']),
                     fmt_f(b['fill_year']['p50'], '.0f'), _band(b['relief_gdp'])])
    d = MdDoc()
    d.table(['Era (start year)', 'Windows', 'Censored', 'Fail share', 'Median fill year',
             'Relief / GDP (p10 / median / p90)'], rows, col_fmt=[LEFT, RIGHT, RIGHT, RIGHT, RIGHT, RIGHT])
    d.caption(f'Table 6: Fund outcomes by era of the window start year. Censored windows never fill, or fill too '
              f'late for the {sc["cfg"]["horizon"]}-year horizon; they are reported, not dropped. {_desc(sc, mode)}.')
    return d


def t7_rate_curve(data, p):
    sc, mode, h, _ = _ctx(data, p)
    rc = sc['calibration']['rate_curve']
    rows = [[f'£{W:g}m', fmt_pct1(t)] for W, t in zip(rc['W_gbp_m'], rc['tau'])]
    d = MdDoc()
    d.table(['Wealth W', 'Marginal rate tau(W)'], rows, col_fmt=[LEFT, RIGHT])
    d.caption(f'Table 7: Rate by wealth, before any threshold indexation. {_desc(sc, mode)}.')
    return d


def t8_closure(data, p):
    sc, mode, h, _ = _ctx(data, p)
    rep = data['meta']['closure_replaced_tax_gdp']
    rows = []
    for iso, b in sorted(h['by_country'].items(), key=lambda kv: (kv[1]['base_multiple_needed']['p50'] or 0)):
        rows.append([f'**{iso}**', fmt_pct1(b['net_gdp_mean']['p50']), _band(b['base_multiple_needed'], fmt_f2)])
    ov = h['overall']
    rows.append(['**All**', fmt_pct1(ov['net_gdp_mean']['p50']), _band(ov['base_multiple_needed'], fmt_f2)])
    d = MdDoc()
    d.table(['Country', 'Net receipts / GDP (median)', 'Base multiple needed (p10 / median / p90)'],
            rows, col_fmt=[LEFT, RIGHT, RIGHT])
    d.caption(f'Table 8: Closure test. Base multiple needed = revenue being replaced ({fmt_pct1(rep)} of GDP; '
              f'JST UK revenue/GDP in the reference year unless [rates.closure] sets a number) over net receipts: how '
              f'many times larger the tax base would have to be, at the same rates, to replace it. {_desc(sc, mode)}.')
    return d


# ── tables 9-12: the hybrid design ───────────────────────────────────────────

def _rng(vals, f=fmt_pct0):
    """'lo to hi' of the non-null values (one value if they coincide)."""
    v = [x for x in vals if x is not None]
    if not v:
        return '—'
    lo, hi = f(min(v)), f(max(v))
    return lo if lo == hi else f'{lo} to {hi}'


def t9_schedule_grid(data, p):
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    rows, used, zs, zxs, first = [], set(), [], [], None
    for name in fg['schedules']:
        sc = _scen(data, name)
        first = first or sc
        m, mu = _med(sc, mode)                                       # fund fills: relief, coverage
        a = wc.scenario_medians(sc, mode, all_windows=True)          # all windows: receipts, burden, floor check
        used.add(mu)
        zs.append(a.get('zuc_share_years'))
        zxs.append(a.get('zucx_share_years'))
        rows.append([f"**{sc['label']}**", _x(m, 'cov_ref', fmt_pct1), _x(m, 'relief_gdp'),
                     _x(a, 'net_gdp_mean'),
                     _x(a, f'er_stock_{grp}'), _x(a, f'er_stock_{top}'),
                     _x(a, f'er_gain_{grp}', fmt_pct1), _x(a, f'er_gain_{top}', fmt_pct1),
                     _x(a, 'zuc_mean'), _x(a, 'zucx_mean')])
    c, exp = first['cfg'], first['calibration']['exp_ref']
    d = MdDoc()
    gl, tl = group_label(grp), group_label(top)
    d.table(['Schedule', 'Spending covered (relief / reference expenditure)', 'Relief / GDP', 'Net WDT / GDP',
             f'Stock rate ({gl})', f'Stock rate ({tl})', f'Gain rate ({gl})', f'Gain rate ({tl})',
             'Billionaire cells: mean annual stock rate', 'Same, excluding heir receipts'],
            rows, col_fmt=[LEFT] + [RIGHT] * 9)
    d.caption(f'Table 9: Hybrid design under two ladders (income-tax-equivalent gain, stock rate) and four logistics '
              f'fitted through their top points, index = {"/".join(sorted(used))}. Spending covered = relief paid '
              f'over the {c["horizon"]} years after fund fill, over fixed reference expenditure ({fmt_pct1(exp)} of '
              f'GDP). Spending covered and relief are medians over windows in which the fund fills; the other '
              f'columns are medians over all windows. Billionaire cells are those with launch wealth of '
              f'£{c["zucman_threshold_gbp_m"]:g}m or more; the table gives their mean annual stock rate against a '
              f'{fmt_pct1(c["zucman_floor"])} floor. The floor is a check, not a target: those cells clear it in '
              f'{_rng(zs)} of years ({_rng(zxs)} excluding heir receipts), and a tax with symmetric refunds is '
              f'expected to fall short of an annual floor in falling-market years, so the mean is the figure to '
              f'read. Stock and gain rates are realised, not target, rates, and wealth-weighted (ratios of sums):'
              f'{gl} pools every net-paying cell, {tl} only the top {tl.removeprefix("top ")} of adults.'
              f' Both include heir receipts.')
    return d


def t10_cohorts(data, p):
    fg = p['rates']['figures']
    mode, grp = fg['mode'], fg['group']
    rows = []
    for name in fg['cohorts']:
        sc = _scen(data, name)
        m, _ = _med(sc, mode)
        a = wc.scenario_medians(sc, mode, all_windows=True)
        coh = sc['calibration'].get('cohort')
        sd = fmt_pct1(coh['tier_sd']) if coh else '—'
        top = fmt_pct1(coh['top_cell_diff'] - coh['bottom_cell_diff']) if coh else '—'
        rows.append([f"**{sc['label']}**", sd, top, _x(m, 'cov_ref', fmt_pct1), _x(a, 'net_gdp_mean'),
                     _x(m, 'relief_gdp'), _x(a, f'er_stock_{grp}'), _x(a, f'er_gain_{grp}', fmt_pct1)])
    d = MdDoc()
    d.table(['Scenario', 'Tier SD', 'Top cell minus bottom cell', 'Spending covered', 'Net WDT / GDP', 'Relief / GDP',
             f'Stock rate ({grp})', f'Gain rate ({grp})'],
            rows, col_fmt=[LEFT] + [RIGHT] * 7)
    d.caption(f'Table 10: Homogeneous returns against persistent return heterogeneity (Fagereng, Guiso, Malacrino and '
              f'Pistaferri 2020), on the legacy baseline and on the hybrid ladders, index = {mode}. Spending covered '
              f'and relief are medians over windows in which the fund fills; the other columns are medians over all '
              f'windows. Differentials are demeaned by launch-wealth weights, so the wealth-weighted mean return is '
              f'unchanged: cohorts move return between holders, they add none. The high variant\'s premium above the '
              f'top 1% is an extrapolation, not an estimate.')
    return d


def t11_schedule_curves(data, p):
    fg = p['rates']['figures']
    names = fg['schedules']
    scs = [_scen(data, n) for n in names]
    grid = scs[0]['calibration']['rate_curve']['W_gbp_m']
    rows = []
    for i, W in enumerate(grid):
        rows.append([f'£{W:g}m'] + [fmt_pct1(s['calibration']['rate_curve']['tau'][i]) for s in scs])
    d = MdDoc()
    d.table(['Wealth W'] + [s['label'] for s in scs], rows, col_fmt=[LEFT] + [RIGHT] * len(scs))
    d.caption('Table 11: Statutory rate applied to the delta, by wealth, before threshold indexation. Ladders were '
              'specified as target effective rates for a holder consuming c_ref and converted once to these rates; '
              'zero below W_min.')
    return d


def t12_scope(data, p):
    fg = p['rates']['figures']
    rows = []
    for name in fg['scope']:
        sc = _scen(data, name)
        s = sc['calibration'].get('scope')
        if s is None:
            continue
        rows.append([f"**{sc['label']}**", f"£{s['wmin_gbp_m']:g}m", fmt_pct1(s['adult_share']),
                     fmt_pct1(s['wealth_share']), s['n_cells']])
    d = MdDoc()
    d.table(['Scenario', 'W_min', 'Adults above W_min at launch', 'Wealth above W_min at launch', 'Cells'],
            rows, col_fmt=[LEFT, RIGHT, RIGHT, RIGHT, RIGHT])
    d.caption('Table 12: Who is in scope at launch, net of mortgage debt (the distribution is net worth, so mortgaged '
              'owners below W_min are excluded by construction). Compare the share of adults in scope with the share '
              'of wealth they hold: W_min tied to the median house price brings in the adults at and above that price, '
              'which is where most of the wealth is. Shares use cell means; with finer body cells the threshold falls '
              'inside a decile, otherwise the share is coarse by up to one decile.')
    return d


# ── tables 13-16: the headline ───────────────────────────────────────────────

def _cell3(d, f=fmt_pct1):
    """'median (p10 to p90)' from a dist_stats block."""
    if not d or d.get('p50') is None:
        return '—'
    return f"{f(d['p50'])} ({f(d['p10'])} to {f(d['p90'])})"


def t13_cover_by_country(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    names, labs = fg['headline'], fg['headline_names']
    scs = [_scen(data, n) for n in names]
    exps = [s['calibration']['exp_ref'] for s in scs]
    nom = [wc.levy_headline(s, mode, 'nominal') for s in scs]
    non = [wc.levy_headline(s, mode, 'none') for s in scs]
    rea = [wc.levy_headline(s, mode, 'real') for s in scs]
    isos = sorted(nom[0]['by_country'], key=lambda i: -(nom[0]['by_country'][i]['cov_ref']['p50'] or 0))
    blank = ['—'] * len(labs)

    def both(f):
        return [f(b) for b in nom] + [f(b) for b in non]

    def stable(b, e):
        v = b['overall']['stable']['relief_gdp_median']
        return '—' if v is None else fmt_pct1(v / e)
    rows = [[f'**{iso}**'] + both(lambda b: _cell3(b['by_country'].get(iso, {}).get('cov_ref'))) for iso in isos]
    rows.append(['**All**'] + both(lambda b: _cell3(b['overall']['cov_ref'])))
    rows.append(['**All, real-basis levy**'] + [_cell3(b['overall']['cov_ref']) for b in rea] + blank)
    rows.append(['**All, stable-drift windows only**'] + [stable(b, e) for b, e in zip(nom, exps)] + [stable(b, e) for b, e in zip(non, exps)])
    rows.append(['**All, censored windows counted as zero**'] + both(lambda b: _cell3(b['overall'].get('cov_ref_uncond'))))
    rows.append(['**Censored share of windows**'] + both(lambda b: fmt_pct1(b['overall']['censored_share'])))
    lo, hi = p['rates']['run']['drift_band']
    d = MdDoc()
    d.table(['Country'] + [f'{l}, with levy' for l in labs] + [f'{l}, no levy' for l in labs], rows,
            col_fmt=[LEFT] + [RIGHT] * (2 * len(labs)))
    d.caption(f'Table 13: Share of reference expenditure ({fmt_pct1(exps[0])} of GDP) covered by relief paid over the '
              f'horizon after fund fill: median (p10 to p90) over windows, with the CORP levy (nominal base) and without it (individual WDT '
              f'alone). ' + ' '.join(f'{n} = {s["label"]}.' for n, s in zip(labs, scs)) + ' ' + _levy_note(scs[0])
              + f' The real-basis row re-runs the with-levy columns on the deflated base: the conservative reading. The stable-drift row '
                f'keeps windows with wealth/GDP at window end within [{fmt_f2(lo)}, {fmt_f2(hi)}] of launch. The censored-as-zero row '
                f'counts a window whose fund never fills (or fills too late for the horizon) as zero relief; part of that censoring is the '
                f'window length, so it is a bound. Country rows are over windows in which the fund fills, so the no-levy columns are '
                f'conditional on a fill that is much rarer without the levy: read them with the censored share.')
    return d


def t14_lever_stack(data, p):
    fg = p['rates']['figures']
    mode, grp = fg['mode'], fg['group']
    rows, prev = [], {}
    for name in fg['stack']:
        sc = _scen(data, name)
        blk = {c: wc.levy_headline(sc, mode, c)['overall'] for c in ('none', 'real', 'nominal')}
        cov = {c: blk[c]['medians'].get('cov_ref') for c in blk}
        step = {c: ('—' if prev.get(c) is None or cov[c] is None else f'{(cov[c] - prev[c]) * 100:+.1f} pp') for c in ('none', 'nominal')}
        adds = '—' if cov['nominal'] is None or cov['none'] is None else f"{(cov['nominal'] - cov['none']) * 100:+.1f} pp"
        prev.update({c: v for c, v in cov.items() if v is not None})
        h, _ = wc.scenario_headline(sc, mode)
        ov = h['overall']
        a = wc.scenario_medians(sc, mode, all_windows=True)
        stable_ = fmt_pct0(ov['stable']['windows'] / ov['uncensored']) if ov['uncensored'] else '—'
        rows.append([f"**{sc['label']}**", _x(blk['none']['medians'], 'cov_ref', fmt_pct1), _x(blk['real']['medians'], 'cov_ref', fmt_pct1),
                     _x(blk['nominal']['medians'], 'cov_ref', fmt_pct1), adds, step['none'], step['nominal'],
                     _x(a, 'wdt_gdp_mean'), _x(a, f'er_stock_{grp}'), _x(a, f'er_gain_{grp}', fmt_pct1), _x(a, 'drift', fmt_f2),
                     stable_, fmt_pct1(blk['none']['censored_share'])])
    d = MdDoc()
    d.table(['Scenario', 'Spending covered, no levy', 'Spending covered, real-basis levy', 'Spending covered, with levy',
             'Levy adds', 'Change on previous, no levy', 'Change on previous, with levy', 'Individual WDT / GDP',
             f'Stock rate ({grp})', f'Gain rate ({grp})', 'Drift (median)', 'Stable windows', 'Censored, no levy'],
            rows, col_fmt=[LEFT] + [RIGHT] * 12)
    d.caption(f'Table 14: Cumulative lever stack, index = {mode}; each row changes one thing from the row above. Spending covered is '
              f'relief over reference expenditure, a median over windows in which the fund fills, with no levy (individual WDT alone), with a '
              f'real-basis levy, and with the nominal-basis levy. Levy adds = with levy minus no levy. Individual WDT / GDP, burden and drift '
              f'are medians over all windows and do not depend on the levy; the burden rates are the individual side only. Stable windows = '
              f'share of fund-filling windows (with levy) with wealth/GDP inside the drift band, a check that a lever is not raising revenue '
              f'by inflating the base. {_levy_note(_scen(data, fg["stack"][0]))} Read the rows together with Table 15.')
    return d


def t15_frontier(data, p):
    fg = p['rates']['figures']
    mode, grp = fg['mode'], fg['group']
    rows = []
    for i, name in enumerate(fg['frontier'], start=1):
        sc = _scen(data, name)
        m, _ = _med(sc, mode)
        a = wc.scenario_medians(sc, mode, all_windows=True)
        cov, st = m.get('cov_ref'), a.get(f'er_stock_{grp}')
        ratio = '—' if cov is None or not st else fmt_f(cov / st, '.1f')
        rows.append([i, f"**{sc['label']}**", _x(m, 'cov_ref', fmt_pct1), _x(a, f'er_stock_{grp}'),
                     _x(a, f'er_gain_{grp}', fmt_pct1), ratio, 'yes' if name in fg['stack'] else ''])
    d = MdDoc()
    d.table(['#', 'Scenario', 'Spending covered', f'Stock rate ({grp})', f'Gain rate ({grp})',
             'Spending covered per point of stock rate', 'In lever stack'],
            rows, col_fmt=[RIGHT, LEFT, RIGHT, RIGHT, RIGHT, RIGHT, LEFT])
    d.caption(f'Table 15: Spending covered against realised burden on the {grp} group, every design, index = {mode}. '
              f'Numbers are the point labels in Figure 15. Burden is net WDT over wealth (stock rate) and over accrued '
              f'return (gain rate), wealth-weighted, medians over all windows. A design that raises more spending '
              f'covered at no more burden sits above and to the left of another.')
    return d


def t16_revenue_by_tier(data, p):
    sc, mode, h, _ = _ctx(data, p)
    bands = sc['calibration'].get('bands')
    if not bands:
        raise SystemExit(f"scenario '{sc['label']}' has no wealth bands in rates_data.json; re-run rates_core.py")
    a = wc.scenario_medians(sc, mode, all_windows=True)
    labels = band_labels(bands['edges_gbp_m'])
    rows = [[f'**{lab}**', fmt_pct1(bands['adult_share'][i]), fmt_pct1(bands['wealth_share'][i]),
             _x(a, f'revshare_band{i}', fmt_pct1)] for i, lab in enumerate(labels)]
    d = MdDoc()
    d.table(['Launch wealth band', 'Share of adults', 'Share of wealth', 'Share of net WDT receipts'], rows,
            col_fmt=[LEFT, RIGHT, RIGHT, RIGHT])
    d.caption(f'Table 16: Where the revenue comes from. Cells are banded by launch mean wealth. Receipts are '
              f'window-total net WDT including heir receipts, medians over all windows, so the column need not sum to '
              f'exactly 100%; a negative share is a band that is a net recipient of refunds. {_desc(sc, mode)}.')
    return d


def t17_tax_replacement(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    has_e = bool(rp['employer_legs'])
    pool = sum(rp['legs'][k]['share_gdp'] for k in rp['unify'])
    pool_e = sum(rp['legs'][k]['share_gdp'] for k in rp['employer_legs'])
    names = {'p50': 'median', 'p10': 'p10', 'p90': 'p90'}
    rows = []
    for name in fg['stack']:
        sc = _scen(data, name)
        rd = wc.levy_headline(sc, mode, case)['overall']['relief_gdp']
        for q in rp['cases']:
            rel = rd.get(q)
            if rel is None:
                continue
            o = wc.threshold_outcomes(rel, rp)
            row = [f"**{sc['label']}**", names.get(q, q), fmt_pct(rel), fmt_pct(o['left']),
                   fmt_pct1(o['to_common'] / pool), _thr(o, rp)]
            if has_e:
                row += [fmt_pct1(o['to_emp'] / pool_e), _thr(o, rp, emp=True)]
            rows.append(row)
    o0 = wc.threshold_outcomes(0.0, rp)
    ut = legs_label(rp['unify'])
    heads = ['Scenario', 'Relief case', 'Relief / GDP', 'Left after CGT, IHT, corporation tax',
             f'Share of {ut} released', thr_head(rp)]
    if has_e:
        heads += [f'Share of {legs_label(rp["employer_legs"])} released', thr_head(rp, emp=True)]
    d = MdDoc()
    d.table(heads, rows, col_fmt=[LEFT, LEFT] + [RIGHT] * (len(heads) - 2))
    s_e = rp['employer_share']
    if has_e:
        et = legs_label(rp['employer_legs'])
        alloc = (f'{fmt_pct0(1 - s_e)} of it funds ONE tax-free threshold X for {ut}: below X a person pays none of them, above X each '
                 f'charges its own rate on the excess. The other {fmt_pct0(s_e)} funds a separate threshold X_e for {et}, which starts lower '
                 f'today (£{o0["allowance_emp"]:,.0f}, against £{o0["allowance"]:,.0f}): below X_e the employer pays none, above it the leg charges '
                 f'its own rate on the excess. The split is a judgment (employer_share in [rates.replacement]), not an estimate. ')
    else:
        alloc = (f'ONE tax-free threshold X for {ut}: below X a person pays none of them, above X each charges its own rate on the excess. ')
    phase = (f' (the marginal rate phases in linearly over £{rp["phase_in_gbp"]:,.0f})' if rp['phase_in_gbp'] > 0 else '')
    below = ''
    if o0['unify_cost_gdp'] > 1e-9 or o0['unify_cost_emp_gdp'] > 1e-9:
        below = (f'Bringing every leg up to its own allowance costs {fmt_pct1(o0["unify_cost_gdp"] + o0["unify_cost_emp_gdp"])} of GDP; where less '
                 f'than that is left the cell reads "< £" with the allowance. ')
    d.caption('Table 17: What the relief buys once the taxes WDT replaces are retired in order: '
              + ', '.join(f'{n.lower()} ({fmt_pct(v)} of GDP)' for n, v in rp['retire'])
              + f'. Relief is read from the scenario with {_CASE_TXT[case]}. A negative figure in column 4 is a shortfall. What is left is split: '
              + alloc
              + f'Liability grows from zero at its threshold{phase}. Every taxpayer is counted, WDT payers included, so nobody who pays today is '
                f'worse off. The higher-rate band moves up with X. Where nothing is left the cell reads "—" and the threshold stays at today\'s level '
                f'(£{o0["allowance"]:,.0f}' + (f' and £{o0["allowance_emp"]:,.0f}' if has_e else '') + f'). {below}'
                f'"> £{rp["x_cap_gbp"]:,.0f}" is the solver cap, not an economic limit. '
                f'{_levy_note(_scen(data, fg["stack"][0]))} Each leg\'s taxpayer counts are scaled so the leg raises its stated share of GDP '
                f'today. Closes against today\'s revenue, so the current deficit is unchanged. Relief starts only at fund fill; before then '
                f'the thresholds do not move. Tax shares, thresholds and taxpayer counts are placeholders. Static.')
    return d


def t18_threshold_by_country(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    has_e = bool(rp['employer_legs'])
    names, labs = fg['headline'], fg['headline_names']
    scs = [_scen(data, n) for n in names]
    hs = [wc.levy_headline(s, mode, case) for s in scs]
    isos = sorted(hs[0]['by_country'], key=lambda i: -(hs[0]['by_country'][i]['relief_gdp']['p50'] or 0))
    rows = []
    for iso in isos + ['All']:
        for lab, h in zip(labs, hs):
            blk = h['overall'] if iso == 'All' else h['by_country'].get(iso, {})
            rd = blk.get('relief_gdp') or {}
            if rd.get('p50') is None:
                continue
            cell = []
            for q in ('p50', 'p10'):
                v = rd.get(q)
                if v is None:
                    cell += ['—'] * (2 + has_e)
                else:
                    o = wc.threshold_outcomes(v, rp)
                    cell += [fmt_pct(v), _thr(o, rp)] + ([_thr(o, rp, emp=True)] if has_e else [])
            rows.append([f'**{iso}**', lab] + cell)
    o0 = wc.threshold_outcomes(0.0, rp)
    pa0 = o0['allowance']
    heads = ['Country', 'Scenario']
    for q, nm in (('p50', 'median'), ('p10', 'p10')):
        heads += [f'Relief / GDP ({nm})', thr_head(rp, suffix=f' ({nm})')] + ([thr_head(rp, emp=True, suffix=f' ({nm})')] if has_e else [])
    d = MdDoc()
    d.table(heads, rows, col_fmt=[LEFT, LEFT] + [RIGHT] * (len(heads) - 2))
    two = (f'the leftover split between one common threshold for {legs_label(rp["unify"])} and a separate one for '
           f'{legs_label(rp["employer_legs"])}' if has_e else f'one common threshold for {legs_label(rp["unify"])}')
    d.caption(f'Table 18: The tax-free thresholds each country\'s relief could reach, by headline scenario, with {_CASE_TXT[case]}. Each '
              f'country is a replay: its relief as a share of GDP is applied to the UK bill (CGT, IHT and corporation tax retired first, then '
              f'{two}), so read it as what a UK-shaped tax system could do with that country\'s '
              f'history, not as a forecast for that country. Today\'s allowance is £{pa0:,.0f}'
              + (f' (£{o0["allowance_emp"]:,.0f} for {legs_label(rp["employer_legs"])})' if has_e else '')
              + f'; "—" means that nothing is left after the retired taxes. "> £{rp["x_cap_gbp"]:,.0f}" is the '
              f'solver cap. Tax shares, thresholds and taxpayer counts are placeholders. Static.')
    return d


def t19_threshold_by_schedule(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case = rp['levy_case']
    inc = rp['example_incomes']
    has_e = bool(rp['employer_legs'])
    rows = []
    for name in fg['thresholds']:
        sc = _scen(data, name)
        rd = wc.levy_headline(sc, mode, case)['overall']['relief_gdp']
        if rd.get('p50') is None:
            rows.append([f"**{sc['label']}**", '—', '—', '—', '—', '—'] + (['—'] if has_e else []) + ['—'] * len(inc))
            continue
        o = {q: wc.threshold_outcomes(rd[q], rp) for q in ('p10', 'p50', 'p90') if rd.get(q) is not None}
        m = o['p50']
        pre = '≥ ' if m['status'] == 'cap' else ''
        rows.append([f"**{sc['label']}**", fmt_pct(rd['p50']), fmt_pct(m['left']),
                     _thr(o['p10'], rp) if 'p10' in o else '—', _thr(m, rp), _thr(o['p90'], rp) if 'p90' in o else '—']
                    + ([_thr(m, rp, emp=True)] if has_e else [])
                    + [f"{pre}£{wc.person_saving(y, m['x'], rp):,.0f}" for y in inc])
    pa0 = wc.threshold_outcomes(0.0, rp)['allowance']
    d = MdDoc()
    d.table(['WDT rate schedule', 'Relief / GDP (median)', 'Left after CGT, IHT, corporation tax',
             thr_head(rp, suffix=' (p10)'), thr_head(rp, suffix=' (median)'), thr_head(rp, suffix=' (p90)')]
            + ([thr_head(rp, emp=True, suffix=' (median)')] if has_e else [])
            + [f'Saves at £{y:,.0f}' for y in inc], rows, col_fmt=[LEFT] + [RIGHT] * (5 + has_e + len(inc)))
    d.caption(f'Table 19: Under each WDT rate schedule, the income below which a person pays neither {legs_label(rp["unify"], " nor ")}'
              + (f' (and the level below which the employer pays no {legs_label(rp["employer_legs"])}, at the median relief)' if has_e else '')
              + f', and what a person '
              f'with each example income saves a year in {legs_label(rp["person_legs"])}, at the median threshold. Today\'s allowance is '
              f'£{pa0:,.0f}; savings are against today\'s system, so a person on £{inc[0]:,.0f} saves only what lies above £{pa0:,.0f} and '
              f'everyone above the allowance gains something. Relief is read from the scenario with {_CASE_TXT[case]}; the p10 and p90 columns '
              f'are the bad-history and good-history ends of the window distribution. Schedules are the rate schedules of Table 9 and the '
              f'steps of the lever stack of Table 14. {_levy_note(_scen(data, fg["thresholds"][0]))} Thresholds follow the Table 17 rules. '
              f'Tax shares, thresholds and taxpayer counts are placeholders. Static.')
    return d

def t20_consumption(data, p):
    fg = p['rates']['figures']
    mode, grp, top = fg['mode'], fg['group'], fg['top_group']
    gl, tl = group_label(grp), group_label(top)
    rows = []
    for name in fg['consumption']:
        sc = _scen(data, name)
        m, _ = _med(sc, mode)                                       # fund fills: coverage, relief
        a = wc.scenario_medians(sc, mode, all_windows=True)         # all windows: the rest
        h, _ = wc.scenario_headline(sc, mode)
        rows.append([f"**{sc['label']}**", _x(a, 'c_used'), _x(a, 'c_rest'), _x(a, 'r_mean'),
                     _x(m, 'cov_ref', fmt_pct1), _x(m, 'relief_gdp'), _x(a, 'net_gdp_mean'),
                     _x(a, f'er_stock_{grp}'), _x(a, f'er_stock_{top}'),
                     _x(a, f'er_gain_{grp}', fmt_pct1), _x(a, f'er_gain_{top}', fmt_pct1),
                     _x(a, 'drift', fmt_f2), fmt_pct1(h['overall']['censored_share'])])
    ref = _scen(data, fg['consumption'][0])
    d = MdDoc()
    d.table(['Scenario', 'c (used)', 'c, cells outside the payout group', 'Mean return r', 'Spending covered',
             'Relief / GDP', 'Net WDT / GDP', f'Stock rate ({gl})', f'Stock rate ({tl})', f'Gain rate ({gl})',
             f'Gain rate ({tl})', 'Drift (median)', 'Censored'],
            rows, col_fmt=[LEFT] + [RIGHT] * 12)
    d.caption(f'Table 20: Consumption sensitivity on the {ref["label"]} schedule, index = {mode}. c is the share of net worth '
              f'drawn down a year; the ladders were calibrated for c_ref = {fmt_pct0(0.01)}, so the realised burden rises as c falls. '
              f'The stationary row solves c per window so an untaxed holder\'s wealth/GDP stays flat (median shown). '
              f'The payout rows apply the stated consumption to the top 6% of adults: in the constrained row the other cells '
              f'absorb the difference so the wealth-weighted mean stays at c, in the unconstrained row they stay at c, which '
              f'raises mean saving and is the upper bound. Spending covered and relief are medians over windows in which the fund '
              f'fills; the other columns, over all windows. Read revenue together with drift: a lower c can raise receipts by '
              f'inflating the base. {_levy_note(ref)}')
    return d

def t21_threshold_beneficiaries(data, p):
    fg = p['rates']['figures']
    mode = fg['mode']
    rp = p['rates']['replacement']
    case, mk = rp['levy_case'], rp['motivated_gbp']
    rows = []
    for name in fg['thresholds']:
        sc = _scen(data, name)
        rd = wc.levy_headline(sc, mode, case)['overall']['relief_gdp']
        if rd.get('p50') is None:
            rows.append([f"**{sc['label']}**"] + ['—'] * 12)
            continue
        o = wc.threshold_outcomes(rd['p50'], rp)
        b = {q: wc.threshold_beneficiaries(wc.threshold_outcomes(rd[q], rp)['x'], rp)
             for q in ('p10', 'p50', 'p90') if rd.get(q) is not None}
        m = b['p50']
        pre = '≥ ' if o['status'] == 'cap' else ''
        rng = (f"{fmt_f(b['p10']['total_gbp_bn'], '.0f')} to {fmt_f(b['p90']['total_gbp_bn'], '.0f')}"
               if 'p10' in b and 'p90' in b else '—')
        scope = sc['calibration']['scope']['adult_share'] * rp['adults_m']
        rows.append([f"**{sc['label']}**", fmt_pct(rd['p50']), _thr(o, rp),
                     fmt_f(m['beneficiaries_m'], '.1f'), fmt_f(m['exempt_m'], '.1f'), fmt_f(m['motivated_m'], '.1f'),
                     f"{pre}£{m['mean_gbp']:,.0f}", f"{pre}£{m['median_gbp']:,.0f}", fmt_pct1(m['mean_pct_income']),
                     f"{pre}{m['total_gbp_bn']:,.1f}", rng,
                     fmt_f(scope, '.1f'), fmt_f(max(m['beneficiaries_m'] - scope, 0.0), '.1f')])
    pa0 = wc.threshold_outcomes(0.0, rp)['allowance']
    d = MdDoc()
    d.table(['Scenario', 'Relief / GDP (median)', thr_head(rp, suffix=' (median)'), 'Beneficiaries, m',
             'Newly tax-free, m', f'Saving ≥ £{mk:,.0f} a year, m', 'Mean saving', 'Median saving',
             'Mean saving, % of income', 'Total saving, £bn (median)', 'Total saving, £bn (p10 to p90)',
             'Adults in WDT scope, m', 'Beneficiaries outside WDT scope, at least, m'],
            rows, col_fmt=[LEFT] + [RIGHT] * 12)
    d.caption(f'Table 21: Who gains from the tax-free threshold, under each WDT rate schedule, at the median threshold. Beneficiaries are '
              f'income-tax payers today (income above £{pa0:,.0f}); newly tax-free are those between £{pa0:,.0f} and the new threshold. '
              f'The beneficiary count is close to a step in the threshold (everyone above the allowance gains once it rises at all), so the '
              f'p10 to p90 range is shown on total saving, which does vary. Saving is the annual income tax and employee NI saved, weighted '
              f'by the share of people at each income who pay NI; the motivated base is the number saving at least £{mk:,.0f} a year, a '
              f'judgment (Figure 21 shows the full distribution). Savings are gross of WDT: the model has no joint income and wealth '
              f'distribution, so it cannot say how many beneficiaries also pay WDT. Adults in WDT scope are those above W_min at launch '
              f'(adult share × {rp["adults_m"]:g}m adults). Beneficiaries outside WDT scope, at least = beneficiaries minus adults in scope: '
              f'a lower bound, reached only if every adult in scope is also an income-tax payer. Total saving is below the relief left in '
              f'Table 17 by the share that funds the employer threshold, which is not a saving to a person. Relief is read from the scenario with '
              f'{_CASE_TXT[case]}; the range is the p10 to p90 of windows, and where p10 relief does not clear the retired taxes the '
              f'threshold does not move and the saving is zero. Taxpayer counts are placeholders scaled to raise each leg\'s stated share '
              f'of GDP. Static.')
    return d

def t22_net_position(data, p):
    sc, mode, h, _ = _ctx(data, p)
    rp = p['rates']['replacement']
    npn = wc.band_net_position(sc, mode, rp)
    if npn is None:
        raise SystemExit(f"scenario '{sc['label']}' has no median relief; cannot build the net position by band")
    labels = band_labels(sc['calibration']['bands']['edges_gbp_m'])
    hz = sc['cfg']['horizon']

    def money(v, signed=False):
        return '—' if v is None else (f'{"+" if v >= 0 else "−"}£{abs(v):,.0f}' if signed else f'£{v:,.0f}')

    def bn(v):
        return f'{"−" if v < 0 else ""}£{abs(v):,.1f}bn'

    def people(n_m):
        """Adults as a count to 3 significant figures: the top bands are hundreds of people, not '0 thousand'."""
        return f'{float(f"{n_m * 1e6:.3g}"):,.0f}'

    def pair(lo, hi):
        return '—' if lo is None or hi is None else f'{money(lo, True)} to {money(hi, True)}'

    adults = sum(r['adults_m'] for r in npn['bands'])
    rows = [[f'**{lab}**', people(r['adults_m']), fmt_pct1(r['wealth_share']), fmt_pct1(r['rev_share']),
             money(r['wdt']), _x(r, 'stock_rate', fmt_pct), money(r['repeal']), money(r['saving']),
             money(r['net'], True), pair(r['net_avg'], r['net_max'])] for lab, r in zip(labels, npn['bands'])]
    src, gdp = npn['sources'], npn['gdp_bn']
    wdt_pc = src['wdt'] * 1e3 / adults
    rep_pc = npn['repeal_bn'] * 1e3 / adults
    rows.append(['**All adults**', people(adults), '100.0%', '100.0%', money(wdt_pc), '—', money(rep_pc),
                 money(npn['avg_saving']), money(npn['avg_saving'] + rep_pc - wdt_pc, True),
                 pair(npn['avg_saving'] + rep_pc - wdt_pc, npn['max_saving'] + rep_pc - wdt_pc)])
    lose = sum(r['adults_m'] for r in npn['bands'] if r['net'] is not None and r['net'] < 0)
    lose_lo = sum(r['adults_m'] for r in npn['bands'] if r['net_max'] is not None and r['net_max'] < 0)
    lose_hi = sum(r['adults_m'] for r in npn['bands'] if r['net_avg'] is not None and r['net_avg'] < 0)
    pre = '≥ ' if npn['status'] == 'cap' else ''
    alloc = {'wdt': 'pro rata to WDT paid', 'wealth': 'pro rata to wealth held'}[rp['repeal_alloc']]
    names = ' and '.join(n.lower() for n in rp['net_repeal'])
    d = MdDoc()
    d.table(['Launch wealth band', 'Adults', 'Share of wealth', 'Share of net WDT receipts', 'WDT paid per adult, a year',
             'WDT as % of band wealth', f'Gain from {names} repeal, per adult', 'Gain from threshold, per adult (income profile)',
             'Net, income-profile reading', 'Net, bounds (average adult to largest saver)'],
            rows, col_fmt=[LEFT] + [RIGHT] * 9)
    d.caption(f'Table 22: Net position by wealth band while relief is being paid, £ per adult a year, positive = better off. Everything is read '
              f'over the years the relief is paid in (the {hz} years after fund fill, windows in which the fund fills, {_CASE_TXT[rp["levy_case"]]}); '
              f'the years before the fill, when nobody receives relief, are not averaged in. Gain = the income tax and employee NI saved by the '
              f'tax-free threshold the median relief funds ({pre}£{npn["x"]:,.0f}), plus the {names} repeal the relief pays for '
              f'(£{npn["repeal_bn"]:,.1f}bn a year, allocated {alloc}), less the WDT the band pays. WDT is the band\'s share of individual net WDT '
              f'receipts over the horizon (heir receipts included, annualised; the CORP levy is excluded, companies pay it) over the adults in the '
              f'band (adult share × {rp["adults_m"]:g}m). WDT as % of band wealth is the same payment as a stock rate over the horizon, which puts '
              f'the bands on one scale where per-adult amounts do not; the top bands are hundreds of people, so their per-adult figures describe a '
              f'handful of cells. The threshold saving follows an income profile for each band (placeholder values in '
              f'[rates.replacement.income_by_wealth], to be replaced by a joint income and wealth cut of the WAS), rescaled so adults\' total saving '
              f'equals what the solver says the relief buys (rescaling factor {npn["profile_scale"]:.2f}; far from 1 means the profile and the '
              f'taxpayer counts disagree). The bounds need no income–wealth link: the average adult saves the total over all adults, the largest '
              f'saver (above the moved higher-rate band) saves {money(npn["max_saving"])}. Adults in net-loss bands: {lose:.1f}m on the income '
              f'profile, {lose_lo:.1f}m to {lose_hi:.1f}m across the bounds. A band is judged on its average, so some adults inside a '
              f'net-winning band still lose. Bands are by launch wealth and cells move over the window; shares are medians, so they need not sum to '
              f'100%. Heir receipts are lumpy within a {hz}-year horizon (deaths fall on six phases across a generation), so the horizon figure '
              f'moves with the fill year. {_desc(sc, mode)}. Static.')

    ret = npn['retired']
    brows = [['Source', 'Individual WDT', bn(src['wdt']), fmt_pct(src['wdt'] / gdp), 'Adults (bands above)'],
             ['Source', 'CORP levy', bn(src['levy']), fmt_pct(src['levy'] / gdp), 'Companies'],
             ['Source', 'Fund investment income less retention', bn(src['fund_net']), fmt_pct(src['fund_net'] / gdp), 'Fund'],
             ['Source', 'Median mismatch (balancing item)', bn(src['mismatch']), fmt_pct(src['mismatch'] / gdp), 'Medians do not add'],
             ['Source', '**Relief paid**', f'**{bn(npn["relief_bn"])}**', f'**{fmt_pct(npn["relief_gdp"])}**', '']]
    for name, v in ret:
        brows.append(['Use', f'{name} retired', bn(v), fmt_pct(v / gdp),
                      'Adults (allocated to bands above)' if name in rp['net_repeal'] else 'Companies'])
    brows.append(['Use', 'Income tax and employee NI saved', bn(npn['person_bn']), fmt_pct(npn['person_bn'] / gdp),
                  'Adults (income profile)'])
    brows.append(['Use', f'Employer NI saved (own threshold £{npn["x_emp"]:,.0f})' if rp['employer_legs'] else 'Employer NI saved',
                  bn(npn['employer_bn']), fmt_pct(npn['employer_bn'] / gdp), 'Employers'])
    if abs(npn['unspent_bn']) > 0.05:
        brows.append(['Use', 'Unspent (threshold above solver cap)', bn(npn['unspent_bn']), fmt_pct(npn['unspent_bn'] / gdp), '—'])
    used = sum(v for _, v in ret) + npn['person_bn'] + npn['employer_bn'] + npn['unspent_bn']
    brows.append(['Use', '**Relief paid**', f'**{bn(used)}**', f'**{fmt_pct(used / gdp)}**', ''])
    adults_net = npn['person_bn'] + npn['repeal_bn'] - src['wdt']
    brows.append(['Adults', 'Net: gains above less individual WDT', bn(adults_net), fmt_pct(adults_net / gdp), '= levy + fund net + mismatch − corporation tax − employer NI'])
    for r_ in brows:
        r_[3] = r_[3].replace('-', '−')
    d.table(['Side', 'Flow', '£bn a year', 'Share of GDP', 'Paid by / goes to'], brows, col_fmt=[LEFT, LEFT, RIGHT, RIGHT, LEFT])
    d.caption(f'Table 22b: Budget behind Table 22, medians over the same windows and years. Relief = individual WDT + CORP levy + fund investment '
              f'income − fund retention in every window; the components are medians, so they do not add exactly and the gap is shown as the '
              f'balancing item. Uses add to relief by construction: the threshold is solved from the same relief. The adults\' net is therefore '
              f'what companies and the fund put in (levy, fund net contribution, mismatch) less what companies receive (corporation tax '
              f'retired, employer NI saved). Table 22 shows the adults only; the rest of the package is here.')
    return d

# (number, slug, function): the numbers and slugs must match FIGURES in 8_3_RATES_charts.py
TABLES = [
    (1, 'relief_by_country', t1_relief_by_country),
    (2, 'coverage_denominators', t2_coverage_denominators),
    (3, 'revenue_components', t3_revenue_components),
    (4, 'rate_grid', t4_rate_grid),
    (5, 'drift', t5_drift),
    (6, 'by_era', t6_by_era),
    (7, 'rate_curve', t7_rate_curve),
    (8, 'closure', t8_closure),
    (9, 'schedule_grid', t9_schedule_grid),
    (10, 'cohorts', t10_cohorts),
    (11, 'schedule_curves', t11_schedule_curves),
    (12, 'scope', t12_scope),
    (13, 'cover_by_country', t13_cover_by_country),
    (14, 'lever_stack', t14_lever_stack),
    (15, 'frontier', t15_frontier),
    (16, 'revenue_by_tier', t16_revenue_by_tier),
    (17, 'tax_replacement', t17_tax_replacement),
    (18, 'threshold_by_country', t18_threshold_by_country),
    (19, 'threshold_by_schedule', t19_threshold_by_schedule),
    (20, 'consumption', t20_consumption),
    (21, 'threshold_beneficiaries', t21_threshold_beneficiaries),
    (22, 'net_position', t22_net_position)
]


def main():
    p = wc.load_rates_params()
    data = wc.load_json(out_dir(CODE) / 'rates_data.json')
    outdir = ensure_dir(out_dir(CODE) / 'tables')
    for n, slug, fn in TABLES:
        fn(data, p).write(outdir / f'rates_table_{n}_{slug}.md', verbose=False)
        print(f'  Table {n}: {slug}')
    print(f'Written {len(TABLES)} tables to {outdir}')


if __name__ == '__main__':
    main()
