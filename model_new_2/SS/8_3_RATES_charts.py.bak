def main():
    import matplotlib
    matplotlib.use('Agg')
    p = wc.load_rates_params()
    data = wc.load_json(out_dir(CODE) / 'rates_data.json')
    for n, slug, fn in FIGURES:
        fn(data, p)
    print(f'Written {len(FIGURES)} figures to {out_dir(CODE) / "charts"}')


if __name__ == '__main__':
    main()
